@{
    Layout = "_Layout";
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-content">
    <header class="top-header">
        <h1>@ViewData["Title"]</h1>
        <p class="page-subtitle">How the Barangay Document Information Management System handles resident information.</p>
    </header>

    <div class="card border-0 shadow-sm p-4">
        <h2 class="h5">Information we record</h2>
        <p>
            The system stores resident records, document requests, certificates issued, blotter
            case entries, announcements and activity reports. These records are used only to
            issue and track barangay documents and services.
        </p>

        <h2 class="h5 mt-4">Who can see this information</h2>
        <p>
            Access is limited to barangay staff operating this system. Records are displayed only
            to the extent required to process a request.
        </p>

        <h2 class="h5 mt-4">How long we keep it</h2>
        <p>
            Records are retained according to the retention schedules and archival rules of the
            barangay, and are disposed of when no longer required.
        </p>

        <h2 class="h5 mt-4">Your rights</h2>
        <p>
            A resident may request access to, correction of, or deletion of their personal
            information by contacting the Barangay Office during office hours.
        </p>
    </div>
</div>
