@model BDIMS.Models.BlotterViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Blotter";

    // Cases still needing follow-up. IN PROGRESS is already the full set of
    // unresolved cases (OPEN is a narrower slice within it), so adding OPEN here
    // would count the same case twice. InProgressCount alone is the workload.
    var attentionCount = Model.InProgressCount;
}

@* The file on disk is Blotter.css. This link used blotter.css, which resolves on
   Windows and 404s on a case-sensitive host, taking the whole page's styling with it. *@
<link rel="stylesheet" href="~/css/Blotter.css" asp-append-version="true" />

<header class="top-header">
    <div>
        <h2 class="header-title">Blotter &amp; Incident Management</h2>
        <p class="header-subtitle">Manage blotter incidents, parties involved, and administrative updates.</p>
    </div>
    <div class="header-actions">
        <button type="button" id="openModalBtn" class="action-button" data-bs-toggle="modal" data-bs-target="#caseModal">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Add Case
        </button>
    </div>
</header>

<div class="content-area">
    <div class="hero-card">
        <div>
            <p class="eyebrow">CASE MONITOR</p>
            <h3 id="attentionCountText">@attentionCount @(attentionCount == 1 ? "case needs" : "cases need") attention</h3>
            <p>Open and active incidents are tracked here for fast follow-up.</p>
        </div>
        <div class="pill">Urgent cases monitored</div>
    </div>

    @* Clicking a card filters the table to that bucket. The mini-card classes are
   untouched -- only ids/data attributes are added so the existing stylesheet keeps
   rendering them exactly as before. The ids on the <strong> values let the status
   modal refresh the counts in place after a save.

   Two cards remain (IN PROGRESS / RESOLVED); the OPEN card was removed. *@
<div class="stats-row stats-row-2col">
    <div class="mini-card info" id="inProgressCard" data-status-bucket="inprogress" role="button" tabindex="0"
         title="Show in-progress cases" aria-label="Filter by in-progress cases">
        <span class="mini-label">In Progress</span>
        <strong id="inProgressCount">@Model.InProgressCount</strong>
    </div>
    <div class="mini-card success" id="resolvedCard" data-status-bucket="resolved" role="button" tabindex="0"
         title="Show resolved cases" aria-label="Filter by resolved cases">
        <span class="mini-label">Resolved</span>
        <strong id="resolvedCount">@Model.ResolvedCount</strong>
    </div>
</div>

    <div class="table-card">
        <div class="table-header">
            <h4>Blotter Cases</h4>
        </div>

        <form method="get" asp-action="Blotter" asp-controller="Home" class="filters-bar">
            <div class="filter-group">
                <label>Search</label>
                <input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="ID, complainant, respondent..." class="filter-input" />
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select id="statusFilter" name="statusFilter" class="filter-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var st in Model.Statuses)
                    {
                        <option value="@st" selected="@(Model.StatusFilter == st)">@st</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Category</label>
                <select name="categoryFilter" class="filter-select" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Priority</label>
                <select name="priorityFilter" class="filter-select" onchange="this.form.submit()">
                    <option value="">All Priorities</option>
                    @foreach (var pr in Model.Priorities)
                    {
                        <option value="@pr" selected="@(Model.PriorityFilter == pr)">@pr</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>From</label>
                <input type="date" name="dateFrom" value="@Model.DateFrom" class="filter-input" onchange="this.form.submit()" />
            </div>
            <div class="filter-group">
                <label>To</label>
                <input type="date" name="dateTo" value="@Model.DateTo" class="filter-input" onchange="this.form.submit()" />
            </div>
            <div class="filter-group filter-actions">
                <a asp-action="Blotter" asp-controller="Home" class="btn-reset-filter">Reset</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Case ID</th>
                        <th>Incident Type</th>
                        <th>Complainant vs Respondent</th>
                        <th>Date &amp; Time Reported</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Cases != null && Model.Cases.Any())
                    {
                        foreach (var item in Model.Cases)
                        {
                            <tr data-case-id="@item.Id"
                                data-title="@item.Title"
                                data-resident="@item.Resident"
                                data-date="@item.DateFiled"
                                data-status="@item.Status"
                                data-incident-type="@item.IncidentType"
                                data-incident-date="@item.IncidentDate"
                                data-location="@item.Location"
                                data-priority="@item.Priority"
                                data-complainant="@item.Resident"
                                data-complainant-contact="@item.ComplainantContact"
                                data-complainant-address="@item.ComplainantAddress"
                                data-respondent="@item.RespondentName"
                                data-respondent-address="@item.RespondentAddress"
                                data-victim="@item.VictimName"
                                data-narrative="@item.Narrative"
                                data-officer="@item.Officer">
                                <td class="case-id">@item.Id</td>
                                <td>@item.IncidentType</td>
                                <td>
                                    <div class="parties-cell">
                                        <span class="party-name">@item.ComplainantName</span>
                                        <span class="party-arrow">vs</span>
                                        <span class="party-name">@(string.IsNullOrWhiteSpace(item.RespondentName) ? "—" : item.RespondentName)</span>
                                    </div>
                                </td>
                                <td>@item.DateFiled</td>
                                <td>
                                    <span class="priority-tag priority-@item.Priority.ToLower()">@item.Priority</span>
                                </td>
                                <td>
                                    <span class="status-tag status-@statusClass(item.Status)">@item.Status</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button type="button" class="icon-btn-case icon-view" title="View Details" aria-label="View Details" onclick="openCaseView(this)"><i class="bi bi-eye"></i></button>
                                        <button type="button" class="icon-btn-case icon-edit" title="Edit" aria-label="Edit" onclick="openEditCase(this)"><i class="bi bi-pencil"></i></button>
                                        <button type="button" class="icon-btn-case icon-status" title="Update Status" aria-label="Update Status" onclick="openStatusCase(this)"><i class="bi bi-arrow-repeat"></i></button>
                                        <button type="button" class="icon-btn-case icon-delete" title="Delete" aria-label="Delete" onclick="deleteCaseConfirm(this)"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="empty-state">No records found. Click <strong>Add Case</strong> to file your first real case.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    string statusClass(string status)
    {
        switch (status)
        {
            case "Under Investigation": return "investigation";
            case "Scheduled for Hearing": return "hearing";
            case "Settled / Amicably Resolved": return "settled";
            case "Referred to PNP": return "pnp";
            case "Issued CFA": return "cfa";
            default: return "open";
        }
    }
}

@* ===================== ADD CASE MODAL ===================== *@
<div class="modal fade" id="caseModal" tabindex="-1" aria-labelledby="caseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="caseModalLabel"><i class="bi bi-clipboard-data"></i> Add Blotter Case</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="blotterCreateForm" method="post" asp-action="CreateBlotter" asp-controller="Home">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-section">
                        <h6 class="form-section-title"><i class="bi bi-clock-history"></i> A. Incident Info &amp; Timestamp</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Incident Type / Category</label>
                                <select name="incidentType" id="addIncidentType" class="form-select" required>
                                    <option value="" selected disabled>Select incident type...</option>
                                    <option>Physical Assault / Injury</option>
                                    <option>Violence Against Women and Children (VAWC) / Domestic</option>
                                    <option>Property Damage / Vandalism</option>
                                    <option>Theft / Robbery</option>
                                    <option>Grave Threats / Verbal Abuse</option>
                                    <option>Boundary / Land Dispute</option>
                                    <option>Public Disturbance / Noise / Nuisance</option>
                                    <option>Others</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date &amp; Time of Incident</label>
                                <input type="datetime-local" name="incidentDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Incident Location / Purok / Sitio</label>
                                <input type="text" name="location" class="form-control" placeholder="e.g. Purok 3, near basketball court" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Priority / Severity</label>
                                <select name="priority" class="form-select">
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="High">High</option>
                                    <option value="Urgent">Urgent</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h6 class="form-section-title"><i class="bi bi-people"></i> B. Parties Involved</h6>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <h6 class="form-sub-section">Complainant (Reporting Person)</h6>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Full Name</label>
                                <input type="text" name="resident" id="addComplainant" class="form-control" placeholder="Full name" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Contact Number</label>
                                <input type="text" name="complainantContact" class="form-control" placeholder="e.g. 0917 123 4567" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Address / Purok</label>
                                <input type="text" name="complainantAddress" class="form-control" placeholder="e.g. Purok 2, Governor Boyles" />
                            </div>
                            <div class="col-md-12">
                                <h6 class="form-sub-section">Respondent (Person Complained Of)</h6>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Full Name / Alias</label>
                                <input type="text" name="respondentName" class="form-control" placeholder="Full name or alias" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Address / Purok</label>
                                <input type="text" name="respondentAddress" class="form-control" placeholder="e.g. Purok 4, Governor Boyles" />
                            </div>
                            <div class="col-md-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="addVictimSame" checked onchange="syncVictimFromComplainant('addComplainant','addVictimSame','addVictim')" />
                                    <label class="form-check-label" for="addVictimSame">Victim is the same as the complainant</label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Victim (if different from complainant)</label>
                                <input type="text" name="victimName" id="addVictim" class="form-control" placeholder="Victim full name" disabled />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h6 class="form-section-title"><i class="bi bi-folder2-open"></i> C. Case Details &amp; Administrative Tracking</h6>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">Incident Narrative / Detailed Summary</label>
                                <textarea name="narrative" class="form-control" rows="4" placeholder="Describe what happened, including time, place, and any witnesses." required></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Initial Status</label>
                                <select name="status" class="form-select">
                                    <option value="Under Investigation" selected>Under Investigation</option>
                                    <option value="Scheduled for Hearing">Scheduled for Hearing</option>
                                    <option value="Resolved">Resolved</option>
                                    <option value="Settled / Amicably Resolved">Settled / Amicably Resolved</option>
                                    <option value="Referred to PNP">Referred to PNP</option>
                                    <option value="Issued CFA">Issued CFA</option>
                                    <option value="Dismissed">Dismissed</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Assigned Officer / Duty Tanod / Secretary</label>
                                <input type="text" name="officer" class="form-control" placeholder="e.g. Kagawad Juan Cruz / Tanod Name" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Save Case</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ===================== VIEW CASE DETAILS MODAL ===================== *@
