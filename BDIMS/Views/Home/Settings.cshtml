@model BDIMS.Models.SettingsViewModel

@{
    ViewData["Title"] = "Settings";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    @* The Template Manager card and the template modal use the .template-* and
       .token-chip styles defined here; without this the placeholder palette and
       the card layout render unstyled. *@
    <link rel="stylesheet" href="~/css/certificatetemplate.css" asp-append-version="true" />
}

<div class="settings-page">
    <div class="settings-body">

        <!-- TOP HEADER -->
        <div class="top-header">
            <div class="header-title-group">
                <h2 class="header-title">Settings</h2>
                <p class="header-subtitle">Configure barangay operational preferences and rules.</p>
            </div>

            <div class="header-actions">
                <!-- Save form trigger -->
                <button type="button" class="btn-save-header" onclick="submitCurrentForm()">
                    <i class="bi bi-floppy me-1"></i> Save Changes
                </button>

                <!-- Search Bar -->
                <form method="get" asp-controller="Home" asp-action="Settings" class="search-box">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" name="searchQuery" placeholder="Search settings..." onchange="this.form.submit();" />
                </form>

                <!-- Notification Bell -->
                <div class="notification-wrapper">
                    <button class="icon-btn notification-button" title="Notifications" type="button" onclick="toggleNotifDropdown(event)">
                        <i class="bi bi-bell"></i>
                        <span id="notifBadgeSettings" class="notif-badge" style="display:none">0</span>
                    </button>
                    <div id="notifDropdown" class="notif-dropdown" aria-hidden="true" data-endpoint-prefix="/Notification"></div>
                </div>

                <!-- User Profile Initials Avatar -->
                @* Same top-right profile badge as the Dashboard header. Only the anchor is
                   added, so the badge, its size and the header row's gap are untouched.
                   Shows the uploaded photo when there is one, the initials otherwise. *@
                <a asp-controller="Account" asp-action="Profile" class="profile-badge-link" title="My Profile">
                    <div class="avatar-circle" data-user-avatar>
                        @if (BDIMS.Services.UserClaims.GetPhotoUrl(User) is { } settingsPhotoUrl)
                        {
                            <img class="avatar-photo-image" src="@settingsPhotoUrl"
                                 alt="@BDIMS.Services.UserClaims.GetDisplayName(User)" />
                        }
                        else
                        {
                            @BDIMS.Services.UserClaims.GetInitials(User)
                        }
                    </div>
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast-success">
                <span>✓</span>
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["TemplateError"] != null)
        {
            <div class="toast-error">
                <span>!</span>
                @TempData["TemplateError"]
            </div>
        }

        <!-- SETTINGS TABS -->
        <div class="settings-tabs">
            <a asp-controller="Home"
               asp-action="Settings"
               asp-route-tab="general"
               class="settings-tab @(Model.ActiveTab == "general" ? "active" : "")">
                <i class="bi bi-bank me-2"></i> Barangay Info
            </a>

            <a asp-controller="Home"
               asp-action="Settings"
               asp-route-tab="documents"
               class="settings-tab @(Model.ActiveTab == "documents" ? "active" : "")">
                <i class="bi bi-file-earmark-text me-2"></i> Certificates & Fees
            </a>

            <a asp-controller="Home"
               asp-action="Settings"
               asp-route-tab="security"
               class="settings-tab @(Model.ActiveTab == "security" ? "active" : "")">
                <i class="bi bi-shield-check me-2"></i> System & Security
            </a>
        </div>

        <!-- CERTIFICATE TEMPLATE EDITOR ENTRY POINT -->
        @* Compact card in the content column. It used to sit inside .header-actions, which
           stretched the top bar and squashed the notification bell and profile badge. The
           Dynamic Placeholders palette and the configured-template list now live in the
           modal opened by the button below. *@
        <div class="settings-card template-editor-card">
            <div class="card-header card-header-with-action">
                <div>
                    <h2>Certificate Template Editor</h2>
                    <p>Design the printable layout, letterhead and logos for each certificate type.</p>
                </div>
                <a asp-controller="Home" asp-action="CertificateTemplateEditor" class="btn-add-certificate template-editor-open">
                    <i class="bi bi-magic me-1"></i> Open Template Editor
                </a>
            </div>
        </div>

        <!-- ONLINE PAYMENT METHODS CARD (GCash QR + account details) -->
        @* Sits directly below the Template Editor card. The button opens
           #paymentMethodModal, where an admin uploads the GCash QR image and
           edits the account name / mobile number residents pay to. *@
        <div class="settings-card template-editor-card">
            <div class="card-header card-header-with-action">
                <div>
                    <h2>Online Payment Methods</h2>
                    <p>Manage the payment method, QR code, and account details residents use for online certificate payments.</p>
                    @if (Model.HasGcashQr)
                    {
                        <span class="badge bg-success mt-1"><i class="bi bi-check-circle me-1"></i>QR uploaded</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mt-1"><i class="bi bi-exclamation-circle me-1"></i>No QR yet</span>
                    }
                </div>
                <button type="button" class="btn-add-certificate" onclick="openPaymentMethodModal()">
                    <i class="bi bi-credit-card me-1"></i> Edit Payment Settings
                </button>
            </div>
        </div>

        <!-- BARANGAY INFO TAB -->
        @if (Model.ActiveTab == "general")
        {
            <form id="generalSettingsForm" asp-controller="Home" asp-action="SaveSettings" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ActiveTab" value="general" />

                <div class="settings-card">
                    <div class="card-header border-0 pb-0">
                        <h2>Barangay Profile & Operations</h2>
                        <p>Manage public details displayed on printed clearances and receipts.</p>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Barangay Name</label>
                            <input type="text" name="BarangayName" value="@Model.BarangayName" placeholder="Barangay Name" />
                        </div>
                        <div class="form-group">
                            <label>Municipality / City</label>
                            <input type="text" name="Municipality" value="@Model.Municipality" placeholder="Municipality / City" />
                        </div>

                        <div class="form-group">
                            <label>Province</label>
                            <input type="text" name="Province" value="@Model.Province" placeholder="Province" />
                        </div>
                        <div class="form-group">
                            <label>Official Email</label>
                            <input type="email" name="ContactEmail" value="@Model.ContactEmail" placeholder="Official Email" />
                        </div>

                        <div class="form-group">
                            <label>Contact Phone</label>
                            <input type="text" name="ContactPhone" value="@Model.ContactPhone" placeholder="Contact Phone" />
                        </div>
                        <div class="form-group">
                            <label>Office Operating Hours</label>
                            <input type="text" name="OfficeHours" value="@Model.OfficeHours" placeholder="8:00 AM - 5:00 PM (Mon-Fri)" />
                        </div>

                        <div class="form-group">
                            <label>Official Document Signatory</label>
                            <input type="text" name="SignatoryName" value="@Model.SignatoryName" placeholder="Official Document Signatory" />
                        </div>
                        <div class="form-group">
                            <label>Signatory Title</label>
                            <input type="text" name="SignatoryRole" value="@Model.SignatoryRole" placeholder="Signatory Title" />
                        </div>
                    </div>

                    <!-- Barangay Logo upload. Stored under wwwroot/uploads/barangay_logo.png
                        and persisted as configured via SaveSettings. Hidden name is not
                        used because the file travels in multipart form data. -->
                    <div class="form-group">
                        <label>Barangay Logo</label>
                        <input type="file" id="barangayLogo" name="LogoFile" accept=".png,.jpg,.jpeg,.webp" />
                    </div>

                    <!-- Additive action row. The form-grid above is untouched, so the
                         field layout is identical to before; this only anchors the save
                         control at the bottom-right of the card. -->
                    <div class="profile-card-footer">
                        <p class="profile-card-hint">
                            These details print on every clearance, certificate and system header.
                        </p>
                        <button type="button" id="btnSaveBarangayProfile" class="btn-save-profile">
                            <i class="bi bi-check2-circle me-1"></i> Save Profile Changes
                        </button>
                    </div>
                </div>
            </form>
        }

        <!-- CERTIFICATES TAB -->
        @if (Model.ActiveTab == "documents")
        {
            <form id="documentsSettingsForm" asp-controller="Home" asp-action="SaveSettings" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ActiveTab" value="documents" />

                <div class="settings-card">
                    <div class="card-header card-header-with-action">
                        <div>
                            <h2>Certificates & Fees</h2>
                            <p>Manage certificate types, fees, and residency requirements.</p>
                        </div>
                        <button type="button" class="btn-add-certificate" onclick="addCertificateRow()">
                            <i class="bi bi-plus-lg me-1"></i> Add Certificate
                        </button>
                    </div>

                    <div class="table-container">
                        <table class="settings-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Certificate Type</th>
                                    <th>Fee</th>
                                    <th>Requires Residency</th>
                                    <th>Status</th>
                                    <th>Template</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Certificates.Count; i++)
                                {
                                    var rowTemplate = Model.TemplateFor(Model.Certificates[i].Type);
                                    var hasLayout = rowTemplate != null
                                        && !string.IsNullOrWhiteSpace(rowTemplate.TemplateHtml);
                                    <tr>
                                        <td>
                                            <span class="row-index">@(i + 1)</span>
                                            <input type="hidden" name="Certificates[@i].Id" value="@Model.Certificates[i].Id" />
                                        </td>
                                        <td class="cert-name-cell">
                                            @* Certificate name shown as plain text + pencil icon.
                                               Hidden Format/Template/IsCustom keep non-null values
                                               on save so the DB never receives null. *@
                                            <div class="cert-name-view">
                                                <span class="cert-name-text" id="certText_@Model.Certificates[i].Id" title="Click to edit" onclick="startCertNameEdit(this)">@Model.Certificates[i].Type</span>
                                                <button type="button" class="cert-name-edit-btn" title="Edit certificate name"
                                                        onclick="startCertNameEdit(this)" aria-label="Edit certificate name">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </div>
                                            <div class="cert-name-edit" style="display:none;">
                                                <input type="text" class="cert-name-input"
                                                       name="Certificates[@i].Type"
                                                       value="@Model.Certificates[i].Type"
                                                       placeholder="Certificate Type"
                                                       aria-label="Certificate type name"
                                                       data-cert-id="@Model.Certificates[i].Id"
                                                       data-original="@Model.Certificates[i].Type"
                                                       onkeydown="certNameInputKey(event, this)" />
                                                <button type="button" class="cert-name-save-btn" title="Save"
                                                        onclick="saveCertName(this)" aria-label="Save certificate name">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button type="button" class="cert-name-cancel-btn" title="Cancel"
                                                        onclick="cancelCertNameEdit(this)" aria-label="Cancel editing">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                            <input type="hidden" class="cert-template-hidden" name="Certificates[@i].Template" value="@(Model.Certificates[i].Template ?? string.Empty)" />
                                            <input type="hidden" class="cert-iscustom-hidden" name="Certificates[@i].IsCustom" value="@(Model.Certificates[i].IsCustom ? "true" : "false")" />
                                        </td>
                                        <td class="cert-fee-cell">
                                            @* Fee shown as clean 2-decimal text + pencil icon.
                                               Clicking swaps in a number input + checkmark save.
                                               Enter/save POSTs /Home/UpdateCertificateFee. *@
                                            <div class="cert-fee-view">
                                                <span class="cert-fee-text" id="certFeeText_@Model.Certificates[i].Id" title="Click to edit" onclick="startCertFeeEdit(this)">@("₱ " + Model.Certificates[i].Fee.ToString("N2"))</span>
                                                <button type="button" class="cert-name-edit-btn" title="Edit fee"
                                                        onclick="startCertFeeEdit(this)" aria-label="Edit fee">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </div>
                                            <div class="cert-fee-edit" style="display:none;">
                                                <div class="fee-input">
                                                    <span>₱</span>
                                                    <input type="number" class="cert-fee-input"
                                                           name="Certificates[@i].Fee"
                                                           value="@Model.Certificates[i].Fee.ToString("F2")"
                                                           min="0" step="0.01"
                                                           aria-label="Certificate fee"
                                                           data-cert-id="@Model.Certificates[i].Id"
                                                           data-original="@Model.Certificates[i].Fee.ToString("F2")"
                                                           onkeydown="certFeeInputKey(event, this)" />
                                                </div>
                                                <button type="button" class="cert-name-save-btn" title="Save"
                                                        onclick="saveCertificateFee(this)" aria-label="Save fee">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button type="button" class="cert-name-cancel-btn" title="Cancel"
                                                        onclick="cancelCertFeeEdit(this)" aria-label="Cancel editing">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <label class="checkbox-container">
                                                <input type="checkbox" name="Certificates[@i].RequiresResidency" value="true" @(Model.Certificates[i].RequiresResidency ? "checked" : "") />
                                                <span>Required</span>
                                            </label>
                                        </td>
                                        <td>
                                            <select name="Certificates[@i].Status" class="status-select" onchange="paintStatusSelect(this)">
                                                <option value="Active" selected="@(Model.Certificates[i].Status == "Active")">Active</option>
                                                <option value="Inactive" selected="@(Model.Certificates[i].Status == "Inactive")">Inactive</option>
                                            </select>
                                        </td>
                                        <td>
                                            <span class="template-status @(hasLayout ? "is-set" : "is-missing")">
                                                @(hasLayout ? "Custom" : "Default")
                                            </span>
                                            <a asp-controller="Home"
                                               asp-action="CertificateTemplateEditor"
                                               asp-route-id="@Model.Certificates[i].Id"
                                               class="icon-btn btn-template-cert @(hasLayout ? "" : "needs-attention")"
                                               title="Open the template editor for @Model.Certificates[i].Type">
                                                <i class="bi bi-file-earmark-richtext"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <button type="button" class="btn-remove-cert" title="Remove" onclick="removeCertificateRow(this)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            @* Kept hidden so bulk Save still posts a non-null Format value. *@
                                            <input type="hidden" class="format-store" name="Certificates[@i].Format" value="@(Model.Certificates[i].Format ?? string.Empty)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="cert-quick-add">
                        <span class="cert-quick-label"><i class="bi bi-plus-circle me-1"></i>Quick Add</span>
                        <input type="text" id="quickCertType" class="cert-type-input" placeholder="Certificate Type (e.g. Purok Clearance)" />
                        <div class="fee-input quick-fee">
                            <span>₱</span>
                            <input type="number" id="quickCertFee" value="0" min="0" step="0.01" />
                        </div>
                        <label class="checkbox-container">
                            <input type="checkbox" id="quickCertRequired" value="true" />
                            <span>Requires Residency</span>
                        </label>
                        <div class="cert-quick-actions">
                            <button type="button" class="btn-add-certificate" onclick="quickAddCertificate()">
                                <i class="bi bi-plus-lg me-1"></i> Add
                            </button>
                            <button type="button" class="btn-save-quick" onclick="submitDocumentsForm()">
                                <i class="bi bi-floppy me-1"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </div>
            </form>

            <!-- CERTIFICATE TEMPLATE MODAL -->
            <div id="templateModal" class="modal fade" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                Template &mdash; <span id="templateModalType" class="template-modal-type"></span>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form id="templateModalForm"
                              asp-controller="Home"
                              asp-action="SaveCertificateTemplateForType"
                              method="post"
                              enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="templateModalName" name="certificateName" value="" />
                            <input type="hidden" id="templateModalId" name="certificateId" value="0" />

                            <div class="modal-body">
                                @* Quick-launch modal for one fee-table row. The paste box was
                                   removed: placeholder badge tags + file uploader stay, and
                                   the footer routes to the official Template Editor page. *@
                                <p class="text-muted">
                                    You can copy these placeholders into the official template
                                    editor, or upload a <strong>.docx</strong> /
                                    <strong>.html</strong> file (max 8&nbsp;MB) below.
                                </p>

                                <div class="template-modal-current" id="templateModalCurrent"></div>

                                <div class="format-hint">
                                    @foreach (var token in Model.TemplateTokens)
                                    {
                                        <button type="button"
                                                class="token-chip"
                                                title="@token.Description &mdash; example: @token.Sample"
                                                onclick="copyToken('@token.Placeholder')">@token.Placeholder</button>
                                    }
                                </div>

                                <label class="template-modal-label" for="templateModalFile">
                                    &hellip;or upload a document
                                </label>
                                <input type="file" id="templateModalFile" name="file" class="form-control" accept=".docx,.html,.htm" />
                                <p class="template-modal-hint">
                                    Layout editing happens in the official Template Editor page.
                                </p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="primary-modal-btn" onclick="openOfficialEditor()">
                                    <i class="bi bi-pencil-square me-1"></i> Open Template Editor
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- FORMAT TEMPLATE MODAL -->
            <div id="formatModal" class="modal fade" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Certificate Format Template</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">
                                Plain-text fallback format for this certificate type. It is only used when the
                                type has no layout in the <strong>Certificate Template Editor</strong>.
                            </p>
                            <div class="format-hint">{RESIDENT} &nbsp; {PURPOSE} &nbsp; {ISSUED} &nbsp; {ORNUMBER} &nbsp; {AMOUNT} &nbsp; {ID} &nbsp; {TITLE}</div>
                            <textarea id="formatModalText" class="form-control" rows="14" placeholder="Paste your certificate format here..."></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="primary-modal-btn" onclick="saveFormatModal()">Save Format</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- SECURITY TAB -->
        @if (Model.ActiveTab == "security")
        {
            <form id="securitySettingsForm" asp-controller="Home" asp-action="SaveSettings" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ActiveTab" value="security" />

                <div class="settings-card">
                    <div class="card-header">
                        <h2>System Preferences</h2>
                        <p>Configure resident alerts and staff activity tracking.</p>
                    </div>

                    <div class="settings-list">
                        <div class="setting-item">
                            <div>
                                <h3>SMS Notifications</h3>
                                <p>Send important alerts through SMS to resident contact numbers.</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="SmsNotifications" value="true" @(Model.SmsNotifications ? "checked" : "") />
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-item">
                            <div>
                                <h3>System Audit Logging</h3>
                                <p>Record staff sign-ins and record changes for administrative accountability.</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="AuditLogging" value="true" @(Model.AuditLogging ? "checked" : "") />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="card-header">
                        <h2>Security</h2>
                        <p>Manage session security and account password rules.</p>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Session Timeout</label>
                            <select name="SessionTimeout">
                                <option value="15" selected="@(Model.SessionTimeout == "15")">15 Minutes</option>
                                <option value="30" selected="@(Model.SessionTimeout == "30")">30 Minutes</option>
                                <option value="60" selected="@(Model.SessionTimeout == "60")">60 Minutes</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Password Policy</label>
                            <select name="PasswordPolicy">
                                <option value="Standard" selected="@(Model.PasswordPolicy == "Standard")">Standard Rules</option>
                                <option value="Strict" selected="@(Model.PasswordPolicy == "Strict")">Strict Rules</option>
                            </select>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Appearance (client-side only). The dark-mode choice is stored under the
                 admin-only "admin_theme" localStorage key, so it is fully isolated from
                 the resident portal's "resident_theme" and never touches the database. -->
            <div class="settings-card">
                <div class="card-header">
                    <h2>Appearance</h2>
                    <p>Choose how the admin portal looks on this device.</p>
                </div>

                <div class="settings-list">
                    <div class="setting-item">
                        <div>
                            <h3>Dark Mode</h3>
                            <p>Applies across every page of the admin portal.</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="adminDarkModeSwitch" />
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- DATABASE MANAGEMENT & BACKUPS -->
            @* Sits outside the Save Changes form on purpose: the download is a
               standalone GET that streams a .sql file, so it must not be tied to the
               settings POST. Uses the shared dark navy .btn-add-certificate style so
               it matches the rest of the application's primary buttons. *@
            <div class="settings-card">
                <div class="card-header card-header-with-action">
                    <div>
                        <h2>Database Management &amp; Backups</h2>
                        <p>Export local MySQL database snapshots to protect resident records and system logs.</p>
                    </div>
                    <a asp-controller="Home"
                       asp-action="DownloadDatabaseBackup"
                       class="btn-add-certificate"
                       title="Download a .sql snapshot of the local database">
                        <i class="bi bi-database-down me-1"></i> Download Database Backup (.sql)
                    </a>
                </div>
            </div>
        }

        <!-- CERTIFICATE TEMPLATE EDITOR MODAL: the Dynamic Placeholders palette and the
             configured-template list live here instead of inline on the page. -->
        <div id="templateEditorModal" class="modal fade" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Certificate Template Editor</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="template-card-heading">
                            <i class="bi bi-braces-asterisk"></i>
                            <strong>Dynamic Placeholders</strong>
                        </div>
                        <p class="template-card-copy">
                            Placeholders written as <code>{{ Token }}</code> are filled automatically when a
                            certificate is previewed, printed or issued. Click a placeholder to copy it, then
                            paste it into your layout in the Template Editor. The official header, seals and
                            signature block stay exactly as you lay them out.
                        </p>

                        <div class="format-hint">
                            @foreach (var token in Model.TemplateTokens)
                            {
                                <button type="button"
                                        class="token-chip"
                                        title="@token.Description - example: @token.Sample"
                                        onclick="copyToken('@token.Placeholder')">@token.Placeholder</button>
                            }
                        </div>

                        <div class="template-card-side mt-3">
                            <span class="template-side-label">Templates configured</span>
                            <strong class="template-side-count">@Model.CertificateTemplates.Count</strong>
                            <ul class="template-type-list">
                                @foreach (var template in Model.CertificateTemplates)
                                {
                                    <li>
                                        <a asp-controller="Home"
                                           asp-action="CertificateTemplateEditor"
                                           asp-route-id="@template.Id">@template.CertificateType</a>
                                    </li>
                                }
                                @if (Model.CertificateTemplates.Count == 0)
                                {
                                    <li class="template-type-empty">No templates yet.</li>
                                }
                            </ul>
                            <p class="template-side-hint">
                                Missing a type? Use the <strong>Template</strong> button on its row in
                                <strong>Certificates &amp; Fees</strong> to paste a layout or upload a
                                <strong>.docx</strong> without leaving this page.
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="secondary-btn" data-bs-dismiss="modal">Close</button>
                        <a asp-controller="Home" asp-action="CertificateTemplateEditor" class="primary-modal-btn">
                            <i class="bi bi-magic me-1"></i> Open Full Editor
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONLINE PAYMENT METHODS MODAL: upload the GCash QR image and edit the
             account name / mobile number residents pay to. Posts to
             /Home/SavePaymentSettings, which stores the QR at
             wwwroot/uploads/gcash_qr.png and persists the details in AppSettings. -->
        <div id="paymentMethodModal" class="modal fade" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Home"
                          asp-action="SavePaymentSettings"
                          method="post"
                          enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Online Payment Methods</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="template-card-copy">
                                Set the payment method name, upload the barangay's QR code, and fill in the
                                account details residents will use for online certificate payments.
                            </p>

                            <div class="form-group mb-3">
                                <label class="template-modal-label" for="paymentMethodName">Payment Method Name</label>
                                <input type="text"
                                       id="paymentMethodName"
                                       name="paymentMethodName"
                                       class="form-control"
                                       value="@Model.PaymentMethodName"
                                       maxlength="50"
                                       placeholder="e.g. GCash, PayMaya, Maya, or Bank Transfer" />
                                <p class="small text-muted mt-1">Shown to residents on the payment modal and reference field.</p>
                            </div>

                            @if (Model.HasGcashQr)
                            {
                                <div class="text-center mb-3">
                                    <img src="~/uploads/gcash_qr.png?@DateTime.Now.Ticks"
                                         alt="Payment QR Code"
                                         style="max-height:180px; border:1px solid #e5e7eb; border-radius:8px; padding:4px; background:#fff;" />
                                    <p class="small text-muted mt-1 mb-0">Current QR on file. Upload a new image to replace it.</p>
                                </div>
                            }

                            <div class="form-group mb-3">
                                <label class="template-modal-label" for="gcashQr">Payment QR Code image</label>
                                <input type="file"
                                       id="gcashQr"
                                       name="gcashQr"
                                       class="form-control"
                                       accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" />
                                <p class="small text-muted mt-1">Leave blank to keep the current image. PNG, JPG or WEBP.</p>
                            </div>

                            <div class="form-group mb-3">
                                <label class="template-modal-label" for="gcashAccountName">Account Name</label>
                                <input type="text"
                                       id="gcashAccountName"
                                       name="gcashAccountName"
                                       class="form-control"
                                       value="@Model.GcashAccountName"
                                       placeholder="e.g. Barangay Governor Boyles" />
                            </div>

                            <div class="form-group mb-0">
                                <label class="template-modal-label" for="gcashAccountNumber">Mobile / Account Number</label>
                                <input type="text"
                                       id="gcashAccountNumber"
                                       name="gcashAccountNumber"
                                       class="form-control"
                                       value="@Model.GcashAccountNumber"
                                       placeholder="e.g. 0917 123 4567" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="primary-modal-btn">
                                <i class="bi bi-check2 me-1"></i> Save Payment Settings
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>


    </div>
</div>

@section Scripts {
    <script>
        // ---------- Inline certificate-name editing ----------
        // Each Certificate Type cell renders plain text + a pencil icon.
        // Clicking either swaps the cell into edit mode (input + checkmark
        // save + cancel). Enter saves via /Home/UpdateCertificateName and
        // returns to text mode; Escape cancels and restores the original.
        function certNameCell(trigger) {
            var cell = trigger ? trigger.closest('.cert-name-cell') : null;
            return cell;
        }

        function showCertNameView(cell, text) {
            if (!cell) return;
            var view = cell.querySelector('.cert-name-view');
            var edit = cell.querySelector('.cert-name-edit');
            var label = cell.querySelector('[data-cert-name-text]');
            var input = cell.querySelector('.cert-name-input');
            if (label && typeof text === 'string') label.textContent = text;
            if (input && typeof text === 'string') {
                input.value = text;
                input.setAttribute('data-original', text);
            }
            if (view) view.style.display = '';
            if (edit) edit.style.display = 'none';
        }

        function startCertNameEdit(trigger) {
            var cell = certNameCell(trigger);
            if (!cell) return;
            var view = cell.querySelector('.cert-name-view');
            var edit = cell.querySelector('.cert-name-edit');
            var input = cell.querySelector('.cert-name-input');
            if (view) view.style.display = 'none';
            if (edit) edit.style.display = '';
            if (input) {
                if (!input.getAttribute('data-original')) {
                    input.setAttribute('data-original', input.value || '');
                }
                input.focus();
                try { input.select(); } catch (e) { /* selection optional */ }
            }
        }

        function cancelCertNameEdit(trigger) {
            var cell = certNameCell(trigger);
            if (!cell) return;
            var input = cell.querySelector('.cert-name-input');
            var original = input ? (input.getAttribute('data-original') || '') : '';
            showCertNameView(cell, original);
        }

        function certNameInputKey(event, input) {
            if (!event) return;
            if (event.key === 'Enter') {
                event.preventDefault();
                saveCertName(input);
            } else if (event.key === 'Escape') {
                event.preventDefault();
                cancelCertNameEdit(input);
            }
        }

        function certNameAntiForgeryToken() {
            var tokenInput = document.querySelector('#documentsSettingsForm input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        function saveCertName(trigger) {
            saveCertificateName(trigger);
        }

        // Inline rename: POSTs JSON { id, name } and updates the #certText_{id}
        // label ONLY after a successful JSON response, so the saved name
        // persists on page refresh (it was written to MySQL server-side).
        function saveCertificateName(trigger) {
            var cell = certNameCell(trigger);
            if (!cell) return;
            var input = cell.querySelector('.cert-name-input');
            if (!input) return;
            var id = parseInt(input.getAttribute('data-cert-id') || '0', 10) || 0;
            var newName = (input.value || '').trim();
            if (!id) {
                if (typeof showToast === 'function') showToast('Save the row first before renaming it.', 'error');
                input.focus();
                return;
            }
            if (!newName) {
                if (typeof showToast === 'function') showToast('Certificate name cannot be empty.', 'error');
                input.focus();
                return;
            }
            fetch('/Home/UpdateCertificateName', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': certNameAntiForgeryToken()
                },
                body: JSON.stringify({ id: id, name: newName })
            }).then(function (res) {
                if (!res.ok) throw new Error('Request failed with status ' + res.status);
                return res.json();
            }).then(function (data) {
                if (data && data.success) {
                    var savedName = data.newName || newName;
                    var label = document.getElementById('certText_' + id);
                    if (label) label.textContent = savedName;
                    showCertNameView(cell, savedName);
                    if (typeof showToast === 'function') showToast('Certificate name saved.', 'success');
                } else {
                    var message = (data && data.message) ? data.message : 'Could not save the certificate name.';
                    if (typeof showToast === 'function') showToast(message, 'error');
                }
            }).catch(function () {
                if (typeof showToast === 'function') showToast('Could not save the certificate name.', 'error');
            });
        }

        // ---------- Inline certificate-fee editing ----------
        // Mirrors the Certificate Type pattern: fee renders as "₱ 30.00" text +
        // pencil icon. Clicking swaps in a number input + checkmark save.
        // Enter/save POSTs JSON { id, fee } to /Home/UpdateCertificateFee and
        // refreshes the text instantly from the server response.
        function certFeeCell(trigger) {
            var cell = trigger ? trigger.closest('.cert-fee-cell') : null;
            return cell;
        }

        function formatFeeText(value) {
            var num = parseFloat(value);
            if (isNaN(num)) num = 0;
            return '₱ ' + num.toFixed(2);
        }

        function showCertFeeView(cell, value) {
            if (!cell) return;
            var view = cell.querySelector('.cert-fee-view');
            var edit = cell.querySelector('.cert-fee-edit');
            var label = cell.querySelector('.cert-fee-text');
            var input = cell.querySelector('.cert-fee-input');
            if (label && typeof value !== 'undefined') label.textContent = formatFeeText(value);
            if (input && typeof value !== 'undefined') {
                var normalized = parseFloat(value);
                input.value = isNaN(normalized) ? '0.00' : normalized.toFixed(2);
                input.setAttribute('data-original', input.value);
            }
            if (view) view.style.display = '';
            if (edit) edit.style.display = 'none';
        }

        function startCertFeeEdit(trigger) {
            var cell = certFeeCell(trigger);
            if (!cell) return;
            var view = cell.querySelector('.cert-fee-view');
            var edit = cell.querySelector('.cert-fee-edit');
            var input = cell.querySelector('.cert-fee-input');
            if (view) view.style.display = 'none';
            if (edit) edit.style.display = '';
            if (input) {
                if (!input.getAttribute('data-original')) {
                    input.setAttribute('data-original', input.value || '0.00');
                }
                input.focus();
                try { input.select(); } catch (e) { /* selection optional */ }
            }
        }

        function cancelCertFeeEdit(trigger) {
            var cell = certFeeCell(trigger);
            if (!cell) return;
            var input = cell.querySelector('.cert-fee-input');
            var original = input ? (input.getAttribute('data-original') || '0.00') : '0.00';
            showCertFeeView(cell, original);
        }

        function certFeeInputKey(event, input) {
            if (!event) return;
            if (event.key === 'Enter') {
                event.preventDefault();
                saveCertificateFee(input);
            } else if (event.key === 'Escape') {
                event.preventDefault();
                cancelCertFeeEdit(input);
            }
        }

        function saveCertificateFee(trigger) {
            var cell = certFeeCell(trigger);
            if (!cell) return;
            var input = cell.querySelector('.cert-fee-input');
            if (!input) return;
            var id = parseInt(input.getAttribute('data-cert-id') || '0', 10) || 0;
            var fee = parseFloat((input.value || '').trim());
            if (!id) {
                if (typeof showToast === 'function') showToast('Save the row first before editing its fee.', 'error');
                input.focus();
                return;
            }
            if (isNaN(fee) || fee < 0) {
                if (typeof showToast === 'function') showToast('Enter a valid fee of 0 or more.', 'error');
                input.focus();
                return;
            }
            fetch('/Home/UpdateCertificateFee', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': certNameAntiForgeryToken()
                },
                body: JSON.stringify({ id: id, fee: fee })
            }).then(function (res) {
                if (!res.ok) throw new Error('Request failed with status ' + res.status);
                return res.json();
            }).then(function (data) {
                if (data && data.success) {
                    var savedFee = (typeof data.newFee !== 'undefined') ? data.newFee : fee;
                    var label = document.getElementById('certFeeText_' + id);
                    if (label) label.textContent = formatFeeText(savedFee);
                    showCertFeeView(cell, savedFee);
                    if (typeof showToast === 'function') showToast('Fee saved.', 'success');
                } else {
                    var message = (data && data.message) ? data.message : 'Could not save the fee.';
                    if (typeof showToast === 'function') showToast(message, 'error');
                }
            }).catch(function () {
                if (typeof showToast === 'function') showToast('Could not save the fee.', 'error');
            });
        }

        // The top "Save Changes" button is outside the tabs, so it has to find the
        // form belonging to whichever tab is on screen. Only one tab's form is
        // rendered at a time, but a hidden modal form can still match a loose
        // selector, so the visible form is preferred explicitly and the first
        // visible candidate wins.
        function submitCurrentForm() {
            var forms = document.querySelectorAll('.settings-body form[method="post"]');
            var target = null;

            for (var i = 0; i < forms.length; i++) {
                if (forms[i].offsetParent !== null) {
                    target = forms[i];
                    break;
                }
            }

            if (!target) { target = document.querySelector('.settings-body form[method="post"]'); }

            if (target) {
                target.submit();
            }
        }

        function addCertificateRow() {
            var tbody = document.querySelector('#documentsSettingsForm tbody');
            if (!tbody) return;
            var row = document.createElement('tr');
            row.innerHTML =
                '<td><span class="row-index"></span>' +
                '<input type="hidden" name="newrow.Id" value="0" /></td>' +
                '<td><input type="text" name="newrow.Type" class="cert-type-input cert-type-value cert-name-input" placeholder="Certificate Type" data-cert-id="0" data-original="" onkeydown="certNameInputKey(event, this)" />' +
                '<input type="hidden" name="newrow.Format" value="" />' +
                '<input type="hidden" name="newrow.Template" value="" />' +
                '<input type="hidden" name="newrow.IsCustom" value="true" /></td>' +
                '<td><div class="fee-input"><span>₱</span><input type="number" name="newrow.Fee" value="0" min="0" step="0.01" /></div></td>' +
                '<td><label class="checkbox-container"><input type="checkbox" name="newrow.RequiresResidency" value="true" /><span>Required</span></label></td>' +
                '<td><select name="newrow.Status" class="status-select" onchange="paintStatusSelect(this)"><option value="Active" selected>Active</option><option value="Inactive">Inactive</option></select></td>' +
                '<td><span class="template-status is-missing">Default</span>' +
                '<span class="icon-btn btn-template-cert needs-attention" title="Save the row first, then open its template"><i class="bi bi-file-earmark-richtext"></i></span></td>' +
                '<td><button type="button" class="btn-remove-cert" title="Remove" onclick="removeCertificateRow(this)"><i class="bi bi-trash"></i></button>' +
                '<input type="hidden" class="format-store" name="newrow.Format" value="" /></td>';
            tbody.appendChild(row);
            updateRowIndices();
            paintStatusSelect(row.querySelector('.status-select'));
            var typeInput = row.querySelector('.cert-type-input');
            if (typeInput) {
                typeInput.focus();
                if (typeof typeInput.scrollIntoView === 'function') typeInput.scrollIntoView({ block: 'nearest' });
            }
        }

        function quickAddCertificate() {
            var tbody = document.querySelector('#documentsSettingsForm tbody');
            if (!tbody) return;
            var typeInput = document.getElementById('quickCertType');
            var feeInput = document.getElementById('quickCertFee');
            var type = (typeInput.value || '').trim();
            if (!type) {
                typeInput.focus();
                return;
            }
            var fee = feeInput.value || '0';
            var required = document.getElementById('quickCertRequired').checked;

            var row = document.createElement('tr');
            row.innerHTML =
                '<td><span class="row-index"></span>' +
                '<input type="hidden" name="newrow.Id" value="0" /></td>' +
                '<td><input type="text" name="newrow.Type" class="cert-type-input cert-type-value cert-name-input" value="' + escapeHtml(type) + '" data-cert-id="0" data-original="' + escapeHtml(type) + '" onkeydown="certNameInputKey(event, this)" />' +
                '<input type="hidden" name="newrow.Format" value="" />' +
                '<input type="hidden" name="newrow.Template" value="" />' +
                '<input type="hidden" name="newrow.IsCustom" value="true" /></td>' +
                '<td><div class="fee-input"><span>₱</span><input type="number" name="newrow.Fee" value="' + escapeHtml(fee) + '" min="0" step="0.01" /></div></td>' +
                '<td><label class="checkbox-container"><input type="checkbox" name="newrow.RequiresResidency" value="true"' + (required ? ' checked' : '') + ' /><span>Required</span></label></td>' +
                '<td><select name="newrow.Status" class="status-select" onchange="paintStatusSelect(this)"><option value="Active" selected>Active</option><option value="Inactive">Inactive</option></select></td>' +
                '<td><span class="template-status is-missing">Default</span>' +
                '<span class="icon-btn btn-template-cert needs-attention" title="Save the row first, then open its template"><i class="bi bi-file-earmark-richtext"></i></span></td>' +
                '<td><button type="button" class="btn-remove-cert" title="Remove" onclick="removeCertificateRow(this)"><i class="bi bi-trash"></i></button>' +
                '<input type="hidden" class="format-store" name="newrow.Format" value="" /></td>';
            tbody.appendChild(row);
            updateRowIndices();
            paintStatusSelect(row.querySelector('.status-select'));

            typeInput.value = '';
            feeInput.value = '0';
            document.getElementById('quickCertRequired').checked = false;
            typeInput.focus();
            var newTypeInput = row.querySelector('.cert-type-input');
            if (newTypeInput && typeof newTypeInput.scrollIntoView === 'function') {
                newTypeInput.scrollIntoView({ block: 'nearest' });
            }
            if (typeof showToast === 'function') {
                showToast('Certificate added. Click Save Changes to keep it.', 'success');
            }
        }

        function submitDocumentsForm() {
            var form = document.getElementById('documentsSettingsForm');
            if (form) form.submit();
        }

        // Opens the paste/upload modal for one fee-table row. The certificate name
        // is read from the row rather than passed through an inline attribute, so a
        // name containing quotes or markup cannot break out into the handler.
        function openTemplateModal(btn) {
            var row = btn.closest('tr');
            // The Certificate Type cell is text-first now: prefer the pencil-edit
            // input (covers text mode via its value and edit mode), then the
            // plain-text label, so renames always resolve the current name.
            var typeEl = row ? row.querySelector('.cert-name-input') : null;
            var labelEl = row ? row.querySelector('[data-cert-name-text]') : null;
            var name = typeEl ? (typeEl.value || '').trim()
                : (labelEl ? (labelEl.textContent || '').trim() : '');
            var idInput = row ? row.querySelector('input[name$=".Id"]') : null;
            var certId = idInput ? (idInput.value || '0') : '0';

            if (!name) {
                if (typeof showToast === 'function') {
                    showToast('Give the certificate a name before setting its template.', 'error');
                }
                if (typeEl && typeof typeEl.focus === 'function') typeEl.focus();
                return;
            }

            var nameInput = document.getElementById('templateModalName');
            var idHidden = document.getElementById('templateModalId');
            var typeLabel = document.getElementById('templateModalType');
            var fileEl = document.getElementById('templateModalFile');

            if (nameInput) nameInput.value = name;
            if (idHidden) idHidden.value = certId;
            if (typeLabel) typeLabel.textContent = name;
            if (fileEl) fileEl.value = '';

            // Tell the administrator what happens if they save nothing, so a blank
            // submit is a deliberate choice rather than a silent no-op.
            var status = row ? row.querySelector('.template-status') : null;
            var current = document.getElementById('templateModalCurrent');
            if (current) {
                current.textContent = status && status.textContent.trim() === 'Custom'
                    ? 'This certificate currently has a saved layout. Saving replaces it.'
                    : 'This certificate has no saved layout, so a generated one is printed.';
            }

            var modalEl = document.getElementById('templateModal');
            if (typeof window.bootstrap !== 'undefined' && bootstrap.Modal) {
                new bootstrap.Modal(modalEl).show();
            } else {
                modalEl.style.display = 'block';
            }
        }

        // Footer launcher for the Template quick modal: routes to the official
        // Template Editor page for the row's certificate (id + type), so layout
        // editing happens in one full-page editor instead of the paste box.
        function openOfficialEditor() {
            var idHidden = document.getElementById('templateModalId');
            var nameInput = document.getElementById('templateModalName');
            var certId = idHidden ? (idHidden.value || '0') : '0';
            var type = nameInput ? (nameInput.value || '').trim() : '';
            var url = '/Home/TemplateEditor?id=' + encodeURIComponent(certId);
            if (type) {
                url += '&type=' + encodeURIComponent(type);
            }
            window.location.href = url;
        }

        var formatTarget = null;

        function openFormatModal(btn) {
            var row = btn.closest('tr');
            var store = row ? row.querySelector('.format-store') : null;
            formatTarget = store;
            var textEl = document.getElementById('formatModalText');
            if (textEl) textEl.value = store ? store.value : '';
            if (typeof window.bootstrap !== 'undefined' && bootstrap.Modal) {
                new bootstrap.Modal(document.getElementById('formatModal')).show();
            } else {
                document.getElementById('formatModal').style.display = 'block';
            }
        }

        function saveFormatModal() {
            if (formatTarget) {
                formatTarget.value = document.getElementById('formatModalText').value;
            }
            if (typeof showToast === 'function') {
                showToast('Format saved. Click Save Changes to keep it.', 'success');
            }
            var modalEl = document.getElementById('formatModal');
            if (typeof window.bootstrap !== 'undefined' && bootstrap.Modal && bootstrap.Modal.getInstance(modalEl)) {
                bootstrap.Modal.getInstance(modalEl).hide();
            } else {
                modalEl.style.display = 'none';
            }
        }

        function removeCertificateRow(btn) {
            var tbody = btn.closest('tbody');
            if (!tbody) return;
            if (tbody.querySelectorAll('tr').length <= 1) return;
            btn.closest('tr').remove();
            updateRowIndices();
        }

        function updateRowIndices() {
            var tbody = document.querySelector('#documentsSettingsForm tbody');
            if (!tbody) return;
            var rows = tbody.querySelectorAll('tr');
            for (var r = 0; r < rows.length; r++) {
                var tr = rows[r];
                var num = tr.querySelector('.row-index');
                if (num) num.textContent = (r + 1);
                var fields = tr.querySelectorAll('input, select, textarea');
                for (var f = 0; f < fields.length; f++) {
                    var el = fields[f];
                    var name = el.getAttribute('name');
                    if (name) {
                        name = name.replace(/^(Certificates\[\d+\]|newrow)\./, 'Certificates[' + r + '].');
                        el.setAttribute('name', name);
                    }
                }
            }
        }

        function paintStatusSelect(sel) {
            if (!sel) return;
            var value = sel.value;
            sel.classList.remove('status-active', 'status-inactive');
            if (value === 'Active') {
                sel.classList.add('status-active');
            } else {
                sel.classList.add('status-inactive');
            }
        }

        // Opens the Certificate Template Editor modal, which carries the Dynamic
        // Placeholders palette and the configured-template list. The full-page editor
        // stays reachable from the modal footer.
        function openTemplateEditorModal() {
            var modalEl = document.getElementById('templateEditorModal');
            if (!modalEl) return;

            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                new bootstrap.Modal(modalEl).show();
            } else {
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
            }
        }

        // Opens the Online Payment Methods modal, where the admin uploads the GCash
        // QR image and edits the account name / mobile number residents pay to.
        function openPaymentMethodModal() {
            var modalEl = document.getElementById('paymentMethodModal');
            if (!modalEl) return;

            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                new bootstrap.Modal(modalEl).show();
            } else {
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
            }
        }

        // Copies a {{ Token }} placeholder so it can be pasted into the Template Editor
        function copyToken(placeholder) {
            var text = String(placeholder || '').replace(/\{\{|\}\}/g, '');

            function write(clipboard) {
                if (clipboard && typeof clipboard.writeText === 'function') {
                    clipboard.writeText(text);
                }
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () {
                    if (typeof showToast === 'function') {
                        showToast(text + ' copied. Paste it in the Template Editor.', 'success');
                    }
                }).catch(function () { fallbackCopy(text); });
            } else {
                fallbackCopy(text);
            }
        }

        function fallbackCopy(text) {
            var helper = document.createElement('textarea');
            helper.value = text;
            helper.setAttribute('readonly', '');
            helper.style.position = 'absolute';
            helper.style.left = '-9999px';
            document.body.appendChild(helper);
            helper.select();

            try {
                document.execCommand('copy');
                if (typeof showToast === 'function') {
                    showToast(text + ' copied. Paste it in the Template Editor.', 'success');
                }
            } catch (e) {
                if (typeof showToast === 'function') {
                    showToast('Could not copy automatically — ' + text, 'error');
                }
            }

            document.body.removeChild(helper);
        }

        // ------------------------------------------------ Barangay Profile save
        //
        // The eight profile inputs already post with #generalSettingsForm, so this
        // posts them as JSON to the dedicated endpoint. The endpoint is antiforgery
        // protected and, because its body is JSON, the token travels in the
        // RequestVerificationToken header (configured in Program.cs).
        function readProfileForm() {
            var form = document.getElementById('generalSettingsForm');
            if (!form) return null;

            function value(name) {
                var el = form.querySelector('[name="' + name + '"]');
                return el ? el.value : '';
            }

            return {
                barangayName: value('BarangayName'),
                municipality: value('Municipality'),
                province: value('Province'),
                contactEmail: value('ContactEmail'),
                contactPhone: value('ContactPhone'),
                officeHours: value('OfficeHours'),
                signatoryName: value('SignatoryName'),
                signatoryRole: value('SignatoryRole')
            };
        }

        function profileAntiforgeryToken() {
            var input = document.querySelector('#generalSettingsForm input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        function highlightProfileField(fieldName) {
            if (!fieldName) return;

            // The wire name is the CLR property name ("BarangayName"), which is also
            // the input's name attribute, so one string addresses the element.
            var el = document.querySelector('#generalSettingsForm [name="' + fieldName + '"]');
            if (!el) return;

            el.style.borderColor = '#dc3545';
            el.focus();

            // Clear the marker once the administrator starts correcting it.
            el.addEventListener('input', function handler() {
                el.style.borderColor = '';
                el.removeEventListener('input', handler);
            });
        }

        function saveBarangayProfile() {
            var button = document.getElementById('btnSaveBarangayProfile');
            var payload = readProfileForm();

            if (!button || !payload) return;

            if (!payload.barangayName || !payload.barangayName.trim()) {
                if (typeof showToast === 'function') {
                    showToast('Barangay Name is required.', 'error');
                }
                highlightProfileField('BarangayName');
                return;
            }

            // Guard against a double submit: the button is disabled for the round
            // trip, so an impatient second click cannot post a half-typed profile.
            var originalHtml = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Saving...';

            function restoreButton() {
                button.disabled = false;
                button.innerHTML = originalHtml;
            }

            fetch('/Settings/SaveBarangayProfile', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': profileAntiforgeryToken()
                },
                body: JSON.stringify(payload)
            })
                .then(function (response) {
                    // A 400 carries a named offending field. A 500 or a dropped
                    // connection has no usable body, so that path is handled
                    // explicitly instead of assuming the response parses.
                    return response.json()
                        .catch(function () {
                            return { success: false, message: 'The server returned an unexpected response.' };
                        })
                        .then(function (data) {
                            return { ok: response.ok, data: data };
                        });
                })
                .then(function (result) {
                    if (result.ok && result.data && result.data.success) {
                        if (typeof showToast === 'function') {
                            showToast(result.data.message || 'Barangay Profile updated successfully!', 'success');
                        }

                        // Immediately mirror the saved profile in the top sidebar header so the
                        // operator sees "Barangay <Name> <Municipality>, <Province> System" change
                        // right away instead of waiting for a page reload. Any other page picks the
                        // value up on its next render because _Layout reads BarangayProfile.Current
                        // from the database on every request.
                        var headerEl = document.getElementById('brandSubtitle');
                        var profile = result.data && result.data.profile;
                        if (headerEl) {
                            headerEl.textContent = 'Barangay ' +
                                (profile && profile.barangayName ? profile.barangayName : payload.barangayName) + ' ' +
                                (profile && profile.municipality ? profile.municipality : payload.municipality) + ', ' +
                                (profile && profile.province ? profile.province : payload.province) + ' System';
                        }
                    } else {
                        var message = (result.data && result.data.message)
                            ? result.data.message
                            : 'The profile could not be saved. Please try again.';

                        if (typeof showToast === 'function') {
                            showToast(message, 'error');
                        }

                        highlightProfileField(result.data && result.data.field);
                    }
                })
                .catch(function () {
                    if (typeof showToast === 'function') {
                        showToast('Could not reach the server. Your changes were not saved.', 'error');
                    }
                })
                .then(restoreButton);
        }

        document.addEventListener('DOMContentLoaded', function () {
            var selects = document.querySelectorAll('#documentsSettingsForm .status-select');
            for (var s = 0; s < selects.length; s++) paintStatusSelect(selects[s]);

            var saveButton = document.getElementById('btnSaveBarangayProfile');
            if (saveButton) {
                saveButton.addEventListener('click', saveBarangayProfile);
            }

            // Ctrl/Cmd+S inside the profile card saves without leaving the page.
            var form = document.getElementById('generalSettingsForm');
            if (form) {
                form.addEventListener('keydown', function (e) {
                    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                        e.preventDefault();
                        saveBarangayProfile();
                    }
                });
            }
        });

        // ------------------------------------------------ Admin Appearance (dark mode)
        // The switch persists the choice under the admin-only "admin_theme" localStorage
        // key - never the shared legacy key and never the resident portal's
        // "resident_theme" - so the two portals stay completely independent. It posts
        // nothing to the server.
        (function () {
            var ADMIN_THEME_KEY = 'admin_theme';
            var root = document.documentElement;
            var toggle = document.getElementById('adminDarkModeSwitch');
            if (!toggle) { return; }

            function isCurrentlyDark() {
                var attr = root.getAttribute('data-bs-theme');
                if (attr === 'dark') { return true; }
                if (attr === 'light') { return false; }
                if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) { return true; }
                return toggle.checked;
            }

            // Reflect the theme the head script in _Layout already applied.
            toggle.checked = isCurrentlyDark();

            toggle.addEventListener('change', function () {
                var theme = toggle.checked ? 'dark' : 'light';
                root.setAttribute('data-bs-theme', theme);

                try {
                    if (window.localStorage) { window.localStorage.setItem(ADMIN_THEME_KEY, theme); }
                } catch (e) { /* storage blocked: the choice simply will not persist */ }
            });
        })();
    </script>
}
