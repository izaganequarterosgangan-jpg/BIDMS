@model BDIMS.Models.DocumentsViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Documents";

    // The stored id (REQ-yyyyMMddHHmmss-XXXX) is too long for the table, so render a
    // compact tail (REQ-XXXX). The full id stays on the row's data-request-id for the
    // edit/delete handlers.
    string ShortRequestId(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return "-";
        }

        var dash = id.LastIndexOf('-');
        var tail = dash >= 0 && dash < id.Length - 1 ? id[(dash + 1)..] : id;

        return tail.StartsWith("REQ-", StringComparison.OrdinalIgnoreCase) ? tail : "REQ-" + tail;
    }
}

<header class="top-header">
    <div>
        <h2 class="header-title">Documents</h2>
        <p class="header-subtitle">Incoming document request queue - review submissions, approve, then issue the certificate.</p>
    </div>
    <div class="header-actions">
        <form asp-controller="Home" asp-action="Documents" method="get" class="search-box">
            <i class="bi bi-search text-muted"></i>
            <input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="Search documents..." onchange="this.form.submit();" />
        </form>
        <button type="button" class="action-button" data-bs-toggle="modal" data-bs-target="#newRequestModal">
            <i class="bi bi-plus-lg"></i> New Request
        </button>
    </div>
</header>

<div class="content-area">
    <div class="hero-card">
        <div>
            <p class="eyebrow">DOCUMENT CENTER</p>
            <h3>@Model.TotalRequests total document requests</h3>
            <p>Online &amp; walk-in requests are tracked here - approve to bridge into certificate printing.</p>
        </div>
        <div class="pill">Updated today</div>
    </div>

    <div class="stats-row cols-4">
        <div class="mini-card warning">
            <span class="mini-label">PENDING</span>
            <strong>@Model.PendingCount</strong>
        </div>
        <div class="mini-card info">
            <span class="mini-label">IN REVIEW</span>
            <strong>@Model.InReviewCount</strong>
        </div>
        <div class="mini-card success">
            <span class="mini-label">APPROVED</span>
            <strong>@Model.ApprovedCount</strong>
        </div>
        <div class="mini-card danger">
            <span class="mini-label">REJECTED</span>
            <strong>@Model.RejectedCount</strong>
        </div>
    </div>

    <div class="table-card">
        <div class="table-header">
            <h4 class="mb-0 fw-bold fs-5">Recent Requests</h4>
            <a asp-controller="Home" asp-action="Certificates" class="secondary-btn">View Certificates</a>
        </div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Request ID</th>
                        <th>Document</th>
                        <th>Resident</th>
                        <th>Purpose</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Requests.Any())
                    {
                        @foreach (var item in Model.Requests)
                        {
                            string statusClass = item.Status switch
                            {
                                "Approved" => "status-approved",
                                "Rejected" => "status-rejected",
                                "Pending" => "status-pending",
                                "In Review" => "status-inreview",
                                "Processing" => "status-processing",
                                _ => "status-processing"
                            };

                            <tr data-request-id="@item.Id"
                                data-resident="@item.Resident"
                                data-doc-title="@item.Title"
                                data-doc-status="@item.Status">
                                <td>
                                    <strong title="@item.Id">@ShortRequestId(item.Id)</strong>
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-danger ms-1 doc-new-badge">NEW</span>
                                    }
                                </td>
                                <td>@item.Title</td>
                                <td>@item.Resident</td>
                                <td><span class="cell-truncate" title="@item.Purpose">@item.Purpose</span></td>
                                <td>@item.Date</td>
                                <td>
                                    <span class="status-pill @statusClass">@item.Status</span>
                                </td>
                                <td>
                                    <div class="action-cell doc-actions">
                                        <button type="button" class="icon-btn-case icon-view"
                                                data-action="view-doc"
                                                title="View Details" aria-label="View request details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="icon-btn-case icon-edit"
                                                data-action="edit-doc"
                                                title="Update Status" aria-label="Edit request status">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (item.Status == "Approved")
                                        {
                                            <a class="icon-btn-case icon-print" title="Issue Certificate" aria-label="Issue certificate"
                                               href="@Url.Action("Certificates", "Home", new { issue = "true", resident = item.Resident, title = item.Title, purpose = item.Purpose, requestId = item.Id })">
                                                <i class="bi bi-award"></i>
                                            </a>
                                        }
                                        <button type="button" class="icon-btn-case icon-delete"
                                                data-action="delete-doc"
                                                title="Delete Request" aria-label="Delete request">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No records found. Click <strong>New Request</strong> to add your first real request.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Create New Document Request *@
<div class="modal fade" id="newRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-plus"></i> Create New Document Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Home" asp-action="CreateDocumentRequest" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body d-flex flex-column gap-3">
                    <div>
                        <label class="form-label fw-semibold">Resident Full Name</label>
                        <input type="text" name="resident" class="form-control" list="residentsDatalist"
                               placeholder="Enter resident full name" autocomplete="off" required value="@Model.PrefillResident" />
                        <datalist id="residentsDatalist">
                            @foreach (var r in Model.Residents)
                            {
                                <option value="@r.Name">@r.Purok</option>
                            }
                        </datalist>
                    </div>
                    <div>
                        <label class="form-label fw-semibold">Document Type</label>
                        <select name="title" class="form-select" required>
                            <option value="" disabled selected="@(string.IsNullOrEmpty(Model.PrefillTitle))">Select document type...</option>
                            <optgroup label="Barangay Certificates">
                                @foreach (var cert in Model.CertificateTypes)
                                {
                                    <option value="@cert.Type" selected="@(cert.Type == Model.PrefillTitle)">@cert.Type</option>
                                }
                            </optgroup>
                            @if (Model.GeneralDocumentTypes.Any())
                            {
                                <optgroup label="Other Request Documents">
                                    @foreach (var g in Model.GeneralDocumentTypes)
                                    {
                                        <option value="@g" selected="@(g == Model.PrefillTitle)">@g</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label fw-semibold">Purpose / Notes</label>
                        <textarea name="purpose" rows="3" class="form-control" placeholder="e.g. For Scholarship, For Local Employment, For PAO Legal Assistance" required>@Model.PrefillPurpose</textarea>
                    </div>
                    <div>
                        <label class="form-label fw-semibold">Supporting Attachments</label>
                        <input type="file" name="attachment" class="form-control" accept=".pdf,image/png,image/jpeg,image/jpg"
                               aria-describedby="attachHelp" />
                        <div class="form-text" id="attachHelp">Optional: Valid ID, Cedula, or Proof of Residency (max 5 MB).</div>
                    </div>
                    <div>
                        <label class="form-label fw-semibold">Initial Status</label>
                        <select name="status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="In Review">In Review</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Update Status *@
<div class="modal fade" id="editStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="editModalTitle">Update Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Home" asp-action="UpdateDocumentStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" id="editRequestId" />
                <div class="modal-body d-flex flex-column gap-2">
                    <p class="mb-1"><strong>Resident:</strong> <span id="editResidentName"></span></p>
                    <p class="mb-3"><strong>Document:</strong> <span id="editDocumentTitle"></span></p>
                    <div>
                        <label class="form-label fw-semibold">Update Status</label>
                        <select name="newStatus" id="editStatusSelect" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="In Review">In Review</option>
                            <option value="Processing">Processing</option>
                            <option value="Approved">Approved</option>
                            <option value="Ready for Pickup">Ready for Pickup</option>
                            <option value="Printed">Printed</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="primary-modal-btn">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* View Request Details (resident info, purpose, payment proof) *@
<div class="modal fade" id="adminViewRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-text"></i> Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="docViewBody"></div>
                <hr />
                <form asp-controller="Home" asp-action="SaveRequestReply" method="post" id="requestReplyForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="requestId" id="requestReplyRequestId" />
                    <div class="mb-3">
                        <label for="adminReplyInput" class="form-label fw-semibold">Admin Reply</label>
                        <textarea id="adminReplyInput"
                                  name="adminReply"
                                  class="form-control"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="Write feedback or instructions for the resident..."
                                  required></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="primary-modal-btn">
                            <i class="bi bi-send me-1"></i>Save &amp; Send Reply
                        </button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="application/json" id="newRequestPrefill">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            open = Model.OpenNewRequest,
            resident = Model.PrefillResident,
            title = Model.PrefillTitle,
            purpose = Model.PrefillPurpose
        }))
    </script>
    <script>
        // Auto-open New Request modal when instructed by server.
        // The prefill values come from the query string, so they are read from a JSON
        // island rather than interpolated into JavaScript string literals: Razor escapes
        // HTML entities inside a <script> block but the browser does not decode them
        // there, which mangles values, and a literal closing script tag in the input
        // would end the block early.
        (function() {
            var prefill = {};
            try {
                prefill = JSON.parse(document.getElementById('newRequestPrefill').textContent) || {};
            } catch (e) {
                return;
            }
            if (String(prefill.open).toLowerCase() !== 'true') {
                return;
            }
            var modalEl = document.getElementById('newRequestModal');
            if (!modalEl) { return; }
            var modal = new bootstrap.Modal(modalEl);
            if (prefill.resident) {
                var input = modalEl.querySelector('input[name="resident"]');
                if (input) input.value = prefill.resident;
            }
            if (prefill.title) {
                var select = modalEl.querySelector('select[name="title"]');
                if (select) select.value = prefill.title;
            }
            if (prefill.purpose) {
                var ta = modalEl.querySelector('textarea[name="purpose"]');
                if (ta) ta.value = prefill.purpose;
            }
            modal.show();
        })();

        // Delegated so resident name and document title are read from data attributes
        // instead of being embedded in an inline onclick handler, where Razor's HTML
        // encoding does not protect the surrounding JavaScript string literal.
        document.addEventListener('click', function (event) {
            var button = event.target.closest('[data-action]');
            if (!button) { return; }
            var row = button.closest('tr[data-request-id]');
            if (!row) { return; }
            var id = row.getAttribute('data-request-id') || '';
            if (button.getAttribute('data-action') === 'view-doc') {
                openDocView(id);
            } else if (button.getAttribute('data-action') === 'edit-doc') {
                openEditModal(
                    id,
                    row.getAttribute('data-resident') || '',
                    row.getAttribute('data-doc-title') || '',
                    row.getAttribute('data-doc-status') || '');
            } else if (button.getAttribute('data-action') === 'delete-doc') {
                deleteDocRequest(id, row);
            }
        });

        // Removes a request over AJAX after an explicit confirmation, so only that row
        // disappears; the table markup, header, badges and other rows are untouched.
        function deleteDocRequest(id, row) {
            if (!window.confirm('Delete request ' + id + '? This cannot be undone.')) {
                return;
            }

            postJson('/Home/DeleteDocumentRequest', 'id=' + encodeURIComponent(id))
                .then(function (r) {
                    if (r.status !== 200) { throw new Error('delete failed'); }
                    return r.json();
                })
                .then(function (data) {
                    if (data && data.success) {
                        if (row) { row.remove(); }
                        showToast('Document request ' + id + ' deleted.', 'success');
                    } else {
                        showToast('Unable to delete request.', 'danger');
                    }
                })
                .catch(function () {
                    showToast('Unable to delete request.', 'danger');
                });
        }

        function openEditModal(id, resident, title, status) {
            document.getElementById('editModalTitle').innerText = 'Update Request: ' + id;
            document.getElementById('editRequestId').value = id;
            document.getElementById('editResidentName').innerText = resident;
            document.getElementById('editDocumentTitle').innerText = title;
            document.getElementById('editStatusSelect').value = status;

            var modal = new bootstrap.Modal(document.getElementById('editStatusModal'));
            modal.show();
        }

        function openDocView(id) {
            var row = document.querySelector('tr[data-request-id="' + CSS.escape(String(id)) + '"]');

            // Opening a request acknowledges it: clear the row's NEW badge and step the
            // sidebar counters down without waiting for a reload. Failure here must not
            // stop the details from opening, so it is fire-and-forget.
            postJson('/Home/MarkDocumentRequestRead', 'id=' + encodeURIComponent(id))
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    clearInlineNewBadges(row);
                    if (data && typeof data.remaining === 'number') {
                        updateSidebarBadges(data.remaining);
                    }
                })
                .catch(function () { /* non-fatal */ });

            fetch('/Home/GetDocumentRequest?id=' + encodeURIComponent(id))
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d || !d.success) { showToast('Unable to load request details.', 'danger'); return; }
                    renderDocView(d.item);
                })
                .catch(function () { showToast('Unable to load request details.', 'danger'); });
        }

        function statusPillClass(status) {
            switch (String(status || '')) {
                case 'Approved': return 'status-approved';
                case 'Rejected': return 'status-rejected';
                case 'Pending': return 'status-pending';
                case 'In Review': return 'status-inreview';
                default: return 'status-processing';
            }
        }

        function renderDocView(doc) {
            var html =
                '<div class="req-detail">' +
                    '<div class="detail-row"><span class="detail-label">Request ID</span><strong>' + escapeHtml(doc.id) + '</strong></div>' +
                    '<div class="detail-row"><span class="detail-label">Document Type</span><strong>' + escapeHtml(doc.title) + '</strong></div>' +
                    '<div class="detail-row"><span class="detail-label">Resident</span><strong>' + escapeHtml(doc.resident) + '</strong></div>' +
                    '<div class="detail-row"><span class="detail-label">Date Filed</span><strong>' + escapeHtml(doc.date) + '</strong></div>' +
                    '<div class="detail-row"><span class="detail-label">Status</span><span class="status-pill ' + statusPillClass(doc.status) + '">' + escapeHtml(doc.status) + '</span></div>' +
                    '<div class="detail-row"><span class="detail-label">Purpose / Notes</span><div class="purpose-text">' + escapeHtml(doc.purpose) + '</div></div>' +
                    '<div class="detail-row"><span class="detail-label">Claim Format</span><div>' + claimFormatHtml(doc) + '</div></div>' +
                    '<div class="detail-row"><span class="detail-label">Payment Proof</span><div class="attachment-preview">' + paymentProofHtml(doc) + '</div></div>' +
                '</div>';

            document.getElementById('docViewBody').innerHTML = html;

            var requestIdField = document.getElementById('requestReplyRequestId');
            var replyField = document.getElementById('adminReplyInput');
            if (requestIdField) requestIdField.value = doc.id || '';
            if (replyField) replyField.value = doc.adminReply || '';

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('adminViewRequestModal'));
            modal.show();
        }

        function claimFormatHtml(doc) {
            var format = String(doc.claimFormat || '').trim();

            if (!format) {
                return '<span class="text-muted"><i class="bi bi-dash-circle me-1"></i>Not specified</span>';
            }

            // Two clearly different badges so the secretary can tell a digital release
            // from a printed pickup without reading the label.
            var isDigital = format.toLowerCase() === 'digital soft copy';
            var cssClass = isDigital ? 'claim-format-digital' : 'claim-format-printed';
            var icon = isDigital ? 'bi-cloud-arrow-down' : 'bi-printer';

            return '<span class="claim-format-badge ' + cssClass + '">' +
                '<i class="bi ' + icon + ' me-1"></i>' + escapeHtml(format) +
                '</span>';
        }

        function paymentProofHtml(doc) {
            var reference = escapeHtml(doc.referenceNumber || '');
            var note = escapeHtml(doc.paymentNote || '');
            var receiptUrl = String(doc.receiptImageUrl || '');

            if (!reference && !note && !receiptUrl) {
                return '<span class="text-muted"><i class="bi bi-dash-circle me-1"></i>No payment proof submitted</span>';
            }

            var html = '';

            if (reference) {
                html += '<div><span class="text-muted small">GCash reference:</span> <strong>' + reference + '</strong></div>';
            }

            if (note) {
                html += '<div class="mt-1"><span class="text-muted small">Note:</span> ' + note + '</div>';
            }

            // Only the fixed receipts folder is accepted, so a tampered database value
            // cannot turn this into a javascript: or off-site URL.
            if (receiptUrl && /^\/uploads\/receipts\/[A-Za-z0-9._-]+$/.test(receiptUrl)) {
                var safeReceiptUrl = escapeHtml(receiptUrl);
                html += '<div class="mt-2"><img src="' + safeReceiptUrl + '" class="attachment-image" alt="GCash receipt" />' +
                        '<div class="mt-2"><a class="btn btn-sm btn-outline-primary" href="' + safeReceiptUrl + '" target="_blank" rel="noopener">' +
                        '<i class="bi bi-box-arrow-up-right me-1"></i>Open receipt</a></div></div>';
            }

            return html;
        }

    </script>
}