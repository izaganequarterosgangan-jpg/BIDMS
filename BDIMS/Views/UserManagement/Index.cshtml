@model List<BDIMS.Models.UserAccount>

@{
    Layout = "_Layout";
    ViewData["Title"] = "User Management - BIDMS";
    int pendingCount = ViewBag.PendingCount ?? 0;
}

@section Styles {
    @* Shared with the Residents registry page: provides .status-badge, .status-dot
       and the .btn-action / .btn-action-danger icon-button styles used below. *@
    <link rel="stylesheet" href="~/css/residents.css" asp-append-version="true" />

    <style>
        /* Each account row is the trigger for the Profile Details modal, so it
           reads as clickable. Empty-state rows carry no data-user-id and keep
           the default cursor. */
        #userAccountsTable tbody tr[data-user-id] {
            cursor: pointer;
        }
    </style>
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-0">User Management</h3>
        <p class="text-muted small mb-0">Manage registered system accounts and their access roles.</p>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap gap-2 mb-3" id="userStatusFilters" role="group" aria-label="Filter user accounts">
            <button type="button" class="btn btn-sm btn-primary" data-status-filter="all">
                All Accounts
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-status-filter="pending">
                Pending Approval
                @if (pendingCount > 0)
                {
                    <span class="badge rounded-pill bg-danger ms-1">@pendingCount</span>
                }
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-status-filter="active">
                Active
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="userAccountsTable">
                <thead class="table-light">
                    <tr class="text-muted small">
                        <th>ACCOUNT ID</th>
                        <th>EMAIL</th>
                        <th>DISPLAY NAME</th>
                        <th>ROLE</th>
                        <th>CONTACT</th>
                        <th>ADMIN</th>
                        <th>STATUS</th>
                        <th>CREATED</th>
                        <th class="text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.Any())
                    {
                        <tr id="userEmptyState">
                            <td colspan="9" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center gap-2">
                                    <i class="bi bi-person-gear fs-1 text-muted"></i>
                                    <p class="fw-semibold mb-0">No user accounts yet</p>
                                    <p class="text-muted small mb-2">Registered user accounts will appear here.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var account in Model)
                    {
                        <tr data-status="@account.Status.ToString().ToLowerInvariant()" data-user-id="@account.Id">
                            <td class="fw-bold text-secondary">#@account.Id</td>
                            <td class="fw-bold">@account.Email</td>
                            <td>@account.DisplayName</td>
                            <td>
                                <span class="text-secondary fw-semibold">
                                    @account.Role
                                </span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(account.ContactNumber) ? "—" : account.ContactNumber)</td>
                            <td>
                                @if (account.IsAdmin)
                                {
                                    <span class="text-warning fw-semibold"><i class="bi bi-shield-fill"></i> Yes</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (account.Status == UserAccountStatus.Pending)
                                {
                                    <span class="status-badge" style="background-color:#fef3c7;color:#92400e;">
                                        <span class="status-dot" style="background-color:#d97706;"></span>
                                        Pending Approval
                                    </span>
                                }
                                else if (account.Status == UserAccountStatus.Active)
                                {
                                    <span class="status-badge status-active">
                                        <span class="status-dot status-dot-active"></span>
                                        Active
                                    </span>
                                }
                                else if (account.Status == UserAccountStatus.Rejected)
                                {
                                    <span class="status-badge status-inactive">
                                        <span class="status-dot status-dot-inactive"></span>
                                        Rejected
                                    </span>
                                }
                                else if (account.Status == UserAccountStatus.Blocked)
                                {
                                    <span class="status-badge status-inactive">
                                        <span class="status-dot status-dot-inactive"></span>
                                        Blocked
                                    </span>
                                }
                                else if (account.Status == UserAccountStatus.Deactivated)
                                {
                                    <span class="status-badge status-inactive">
                                        <span class="status-dot status-dot-inactive"></span>
                                        Deactivated
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge @(account.IsActive ? "status-active" : "status-inactive")">
                                        <span class="status-dot @(account.IsActive ? "status-dot-active" : "status-dot-inactive")"></span>
                                        @(account.IsActive ? "Active" : "Inactive")
                                    </span>
                                }
                            </td>
                            <td>@account.CreatedUtc.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                @if (account.Status == UserAccountStatus.Pending)
                                {
                                    @* Approve/Reject are rendered only for accounts awaiting
                                       approval; the forms carry data-approval-action so the
                                       status filter JS can additionally show them only while
                                       the "Pending Approval" tab is active - the All/Active
                                       tabs never display them, even on pending rows. *@
                                    <form asp-controller="UserManagement" asp-action="ApproveUser" asp-route-id="@account.Id" method="post" class="d-inline ms-1" data-approval-action>
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success" title="Approve" aria-label="Approve @account.DisplayName">Approve</button>
                                    </form>
                                    <form asp-controller="UserManagement" asp-action="RejectUser" asp-route-id="@account.Id" method="post" class="d-inline ms-1" data-approval-action>
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject" aria-label="Reject @account.DisplayName">Reject</button>
                                    </form>
                                }
                                @if (account.Id != (int?)ViewBag.CurrentUserId)
                                {
                                    @* Timed lockout: clock icon opens the block-duration modal.
                                       Hidden on the signed-in admin's own row - the controller
                                       refuses to lock yourself, so the button would only
                                       ever produce an error message. *@
                                    <button type="button" class="btn btn-sm btn-action" title="Set Lockout"
                                            aria-label="Set lockout for @account.DisplayName"
                                            data-user-id="@account.Id"
                                            data-user-name="@account.DisplayName"
                                            onclick="openUserLockoutModal(this)">
                                        <i class="bi bi-clock-history"></i>
                                    </button>
                                }
                                @if (!account.IsAdmin || account.Id != (int?)ViewBag.CurrentUserId)
                                {
                                    @* Delete Account: trash icon opens the confirmation popup. *@
                                    <button type="button" class="btn btn-sm btn-action btn-action-danger" title="Delete Account"
                                            aria-label="Delete account for @account.DisplayName"
                                            data-user-id="@account.Id"
                                            data-user-name="@account.DisplayName"
                                            onclick="openDeleteUserModal(this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-action" title="Edit"
                                        aria-label="Edit @account.DisplayName"
                                        data-user-id="@account.Id"
                                        data-user-name="@account.DisplayName"
                                        data-user-role="@account.Role"
                                        onclick="openEditUserModal(this)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    <tr id="userFilterEmptyState" style="display:none;">
                        <td colspan="9" class="text-center py-4 text-muted">
                            No accounts match this filter.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== Edit Account Modal ===== -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Edit Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="UserManagement" asp-action="UpdateUserAccount" method="post" id="editUserForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editUserId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editUserDisplayName" class="form-label fw-semibold">Display Name</label>
                        <input type="text" class="form-control" id="editUserDisplayName" name="displayName"
                               maxlength="150" required autocomplete="off" />
                    </div>
                    <div class="mb-0">
                        <label for="editUserRole" class="form-label fw-semibold">Assigned Role</label>
                        @* The system's only three assignable roles. Server-side,
                           UserManagementController.IsAssignableRole rejects any
                           other value so a tampered form cannot write one. *@
                        <select class="form-select" id="editUserRole" name="role" required>
                            <option value="Administrator">Administrator</option>
                            <option value="Barangay Secretary">Barangay Secretary</option>
                            <option value="Resident">Resident</option>
                        </select>
                        <div class="form-text">Changing this also updates the account's administrator access.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Timed Lockout Modal ===== -->
<div class="modal fade" id="userLockoutModal" tabindex="-1" aria-labelledby="userLockoutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userLockoutModalLabel">
                    <i class="bi bi-clock-history me-2"></i>Set Account Lockout
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="UserManagement" asp-action="SetUserLockout" method="post" id="userLockoutForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="lockoutUserId" />
                <input type="hidden" name="durationHours" id="lockoutDurationHours" value="24" />
                <div class="modal-body">
                    <p class="mb-3">
                        Lock <strong id="lockoutUserName">this account</strong> for a set period.
                        While locked, the account cannot sign in and the block lifts automatically
                        when the timer expires.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary lockout-preset" data-hours="1">1 Hour</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary lockout-preset" data-hours="3">3 Hours</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary lockout-preset" data-hours="12">12 Hours</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary lockout-preset" data-hours="24">24 Hours</button>
                    </div>
                    <div class="mb-3">
                        <label for="lockoutCustomHours" class="form-label small fw-semibold">Custom duration (hours)</label>
                        <input type="number" class="form-control" id="lockoutCustomHours" min="1" max="168" value="24" />
                        <div class="form-text">Between 1 and 168 hours (7 days).</div>
                    </div>
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-unlock me-1"></i>
                        Use <strong>Unlock / Unblock Now</strong> below to lift an existing lock immediately.
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-outline-success" id="unblockUserBtn">
                        <i class="bi bi-unlock me-1"></i>Unlock / Unblock Now
                    </button>
                    <div>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger" id="applyLockoutBtn">
                            <i class="bi bi-lock me-1"></i>Apply Lockout
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== View Profile Details Modal ===== -->
<div class="modal fade" id="profileDetailsModal" tabindex="-1" aria-labelledby="profileDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="profileDetailsModalLabel">
                    <i class="bi bi-person-lines-fill me-2"></i>Profile Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-3 pb-3 mb-3 border-bottom">
                    <img id="modalProfilePicture" src="" alt="Profile photo"
                         class="rounded-circle border" width="72" height="72"
                         style="object-fit:cover;background-color:#e2e8f0;" />
                    <div>
                        <h6 class="mb-1" id="profileModalName">—</h6>
                        <div class="small text-muted" id="profileModalEmail">—</div>
                        <div class="mt-1" id="profileModalStatus"></div>
                    </div>
                </div>
                <div class="row g-3 small">
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Employee ID</span><span id="profileModalEmployeeId">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Role</span><span id="profileModalRole">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">First Name</span><span id="profileModalFirstName">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Middle Name</span><span id="profileModalMiddleName">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Last Name</span><span id="profileModalLastName">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Suffix</span><span id="profileModalSuffix">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Age</span><span id="profileModalAge">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Gender</span><span id="profileModalGender">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Date of Birth</span><span id="profileModalDateOfBirth">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Civil Status</span><span id="profileModalCivilStatus">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Purok</span><span id="profileModalPurok">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Voter Status</span><span id="profileModalVoterStatus">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Contact Number</span><span id="profileModalContactNumber">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Account Created</span><span id="profileModalCreated">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Lockout Ends</span><span id="profileModalLockoutEnd">—</span></div>
                    <div class="col-12 col-sm-6"><span class="text-muted d-block">Lockout Reason</span><span id="profileModalLockoutReason">—</span></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== Delete Account Confirmation Modal ===== -->
<div class="modal fade" id="deleteUserConfirmModal" tabindex="-1" aria-labelledby="deleteUserConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteUserConfirmModalLabel">
                    <i class="bi bi-exclamation-triangle me-2 text-danger"></i>Delete Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="UserManagement" asp-action="DeleteUser" method="post" id="deleteUserForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteUserId" />
                <div class="modal-body">
                    <p class="mb-0">
                        Are you sure you want to permanently delete
                        <strong id="deleteUserName">this account</strong>?
                    </p>
                    <p class="small text-muted mt-2 mb-0">
                        This removes the account and all of its records. This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // User Management module: lockout, profile details and delete confirmation.
        // Mirrors the bootstrap.Modal usage pattern already used in Settings.cshtml.
        function showBootstrapModal(modalEl) {
            if (!modalEl) return;
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                new bootstrap.Modal(modalEl).show();
            } else {
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
                modalEl.setAttribute('aria-hidden', 'false');
            }
        }

        function hideBootstrapModal(modalEl) {
            if (!modalEl) return;
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                var instance = bootstrap.Modal.getInstance(modalEl);
                if (instance) {
                    instance.hide();
                } else {
                    new bootstrap.Modal(modalEl).hide();
                }
            } else {
                modalEl.classList.remove('show');
                modalEl.style.display = 'none';
                modalEl.setAttribute('aria-hidden', 'true');
            }
        }

        // ---- Status filters ------------------------------------------------
        (function () {
            var filterButtons = document.querySelectorAll('[data-status-filter]');
            var rows = document.querySelectorAll('#userAccountsTable tbody tr[data-status]');
            var emptyState = document.getElementById('userFilterEmptyState');

            function applyStatusFilter(status) {
                var visibleRows = 0;

                for (var i = 0; i < rows.length; i++) {
                    var rowStatus = rows[i].getAttribute('data-status');
                    var matches = status === 'all' || rowStatus === status;
                    rows[i].style.display = matches ? '' : 'none';

                    // Approve/Reject are a tool of the "Pending Approval" tab
                    // only: they stay hidden on the All/Active tabs even when a
                    // row's status is pending, so those tabs only ever show the
                    // row-management actions. Razor still renders the forms for
                    // pending rows alone; this client-side pass keys their
                    // visibility off the active tab.
                    var approvalActions = rows[i].querySelectorAll('[data-approval-action]');
                    for (var k = 0; k < approvalActions.length; k++) {
                        approvalActions[k].style.display = status === 'pending' ? '' : 'none';
                    }

                    if (matches) {
                        visibleRows++;
                    }
                }

                if (emptyState) {
                    emptyState.style.display = rows.length > 0 && visibleRows === 0 ? '' : 'none';
                }

                for (var j = 0; j < filterButtons.length; j++) {
                    var isActive = filterButtons[j].getAttribute('data-status-filter') === status;
                    filterButtons[j].classList.toggle('btn-primary', isActive);
                    filterButtons[j].classList.toggle('btn-outline-secondary', !isActive);
                }
            }

            for (var i = 0; i < filterButtons.length; i++) {
                filterButtons[i].addEventListener('click', function () {
                    applyStatusFilter(this.getAttribute('data-status-filter') || 'all');
                });
            }

            // Apply the rule on first paint too, so the pending-only visibility
            // holds before any tab has been clicked.
            applyStatusFilter('all');
        })();

        // ---- Row click -> Profile Details ------------------------------------
        // The whole row stands in for the old eye icon: clicking anywhere on it
        // opens the Profile Details modal. Interactive controls inside the row
        // (action buttons, Approve/Reject forms, links, inputs) keep their own
        // behaviour and are excluded so they never bubble into the modal.
        document.getElementById('userAccountsTable').addEventListener('click', function (e) {
            var row = e.target.closest('tr[data-user-id]');
            if (!row) return;

            if (e.target.closest('button, a, form, input, select, textarea, label')) {
                return;
            }

            viewUserDetails(row);
        });

        // ---- Edit account --------------------------------------------------
        // The row's current values travel in data attributes so names containing
        // quotes cannot break out of an inline handler.
        function openEditUserModal(button) {
            var modalEl = document.getElementById('editUserModal');
            if (!modalEl) return;

            var userId = button.getAttribute('data-user-id') || '';
            var displayName = button.getAttribute('data-user-name') || '';
            var role = button.getAttribute('data-user-role') || 'Resident';

            var idField = document.getElementById('editUserId');
            var nameField = document.getElementById('editUserDisplayName');
            var roleField = document.getElementById('editUserRole');

            if (idField) idField.value = userId;
            if (nameField) nameField.value = displayName;

            if (roleField) {
                var hasRole = false;
                for (var i = 0; i < roleField.options.length; i++) {
                    if (roleField.options[i].value === role) {
                        hasRole = true;
                        break;
                    }
                }

                // Preserve a legacy/custom role instead of silently reassigning it.
                if (!hasRole && role) {
                    var option = document.createElement('option');
                    option.value = role;
                    option.textContent = role;
                    roleField.appendChild(option);
                }

                roleField.value = role || 'Resident';
            }

            showBootstrapModal(modalEl);
        }

        // ---- Timed lockout -------------------------------------------------
        // The button carries the id/name in data attributes, so a display name
        // containing an apostrophe can never break out of an inline handler.
        function openUserLockoutModal(button) {
            var modalEl = document.getElementById('userLockoutModal');
            if (!modalEl) return;

            var userId = button.getAttribute('data-user-id');
            var displayName = button.getAttribute('data-user-name');

            var idField = document.getElementById('lockoutUserId');
            var nameLabel = document.getElementById('lockoutUserName');
            var hoursField = document.getElementById('lockoutDurationHours');
            var customField = document.getElementById('lockoutCustomHours');

            if (idField) idField.value = userId || '';
            if (nameLabel) nameLabel.textContent = displayName || 'this account';
            if (hoursField) hoursField.value = '24';
            if (customField) customField.value = '24';

            // Reset the unlock flag: form.submit() bypasses the submit event, so
            // the flag is never cleared on that path and must not leak into the
            // next time the modal is opened.
            isUnlockingUser = false;

            showBootstrapModal(modalEl);
        }

        function setLockoutPreset(hours) {
            var hoursField = document.getElementById('lockoutDurationHours');
            var customField = document.getElementById('lockoutCustomHours');
            if (hoursField) hoursField.value = String(hours);
            if (customField) customField.value = String(hours);

            var presets = document.querySelectorAll('.lockout-preset');
            for (var i = 0; i < presets.length; i++) {
                var isActive = presets[i].getAttribute('data-hours') === String(hours);
                presets[i].classList.toggle('btn-secondary', isActive);
                presets[i].classList.toggle('btn-outline-secondary', !isActive);
            }
        }

        // "Unlock / Unblock Now" posts durationHours = 0, which the controller
        // treats as "lift the block immediately" instead of setting a timer.
        // The flag tells the form's submit guard that this is an intentional
        // unlock, not a missing duration.
        var isUnlockingUser = false;

        function unlockUserNow() {
            isUnlockingUser = true;

            var hoursField = document.getElementById('lockoutDurationHours');
            var customField = document.getElementById('lockoutCustomHours');
            if (hoursField) hoursField.value = '0';
            if (customField) customField.value = '0';

            var form = document.getElementById('userLockoutForm');
            if (form) {
                form.submit();
            }
        }

        // ---- View profile details ------------------------------------------
        function setProfileValue(elementId, value) {
            var el = document.getElementById(elementId);
            if (!el) return;
            var text = (value === null || value === undefined || value === '') ? '-' : String(value);
            el.textContent = text;
        }

        // Defensive fallback for older payloads that predate the server-side age:
        // when age is missing but a Date of Birth is present, derive the whole-year age.
        function calculateAgeFromDateOfBirth(dateOfBirth, serverAge) {
            if (serverAge !== null && serverAge !== undefined && serverAge !== '') {
                return serverAge;
            }

            if (!dateOfBirth) return null;

            var dob = new Date(dateOfBirth);
            if (isNaN(dob.getTime())) return null;

            var today = new Date();
            var age = today.getFullYear() - dob.getFullYear();
            var monthDiff = today.getMonth() - dob.getMonth();

            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                age--;
            }

            return age >= 0 ? age : null;
        }

        function viewUserDetails(button) {
            var modalEl = document.getElementById('profileDetailsModal');
            if (!modalEl) return;

            var id = button.getAttribute('data-user-id');

            // Show the modal straight away, then fill it in when the JSON arrives.
            showBootstrapModal(modalEl);

            fetch('/UserManagement/GetUserProfile?id=' + encodeURIComponent(id), {
                headers: { 'Accept': 'application/json' }
            })
                .then(function (response) {
                    if (!response.ok) throw new Error('Request failed');
                    return response.json();
                })
                .then(function (data) {
                    if (!data || data.success !== true) {
                        throw new Error((data && data.message) || 'Could not load the profile.');
                    }

                    setProfileValue('profileModalName', data.displayName);
                    setProfileValue('profileModalEmail', data.email);
                    setProfileValue('profileModalEmployeeId', data.employeeId);
                    setProfileValue('profileModalRole', data.role);
                    setProfileValue('profileModalFirstName', data.firstName);
                    setProfileValue('profileModalMiddleName', data.middleName);
                    setProfileValue('profileModalLastName', data.lastName);
                    setProfileValue('profileModalSuffix', data.suffix);
                    setProfileValue('profileModalAge',
                        calculateAgeFromDateOfBirth(data.dateOfBirth, data.age));
                    setProfileValue('profileModalGender', data.gender);
                    setProfileValue('profileModalDateOfBirth', data.dateOfBirth);
                    setProfileValue('profileModalCivilStatus', data.civilStatus);
                    setProfileValue('profileModalPurok', data.purok);
                    setProfileValue('profileModalVoterStatus', data.voterStatus);
                    setProfileValue('profileModalContactNumber', data.contactNumber);
                    setProfileValue('profileModalCreated', data.createdUtc);
                    setProfileValue('profileModalLockoutEnd', data.lockoutEnd);
                    setProfileValue('profileModalLockoutReason', data.lockoutReason);

                    var statusEl = document.getElementById('profileModalStatus');
                    if (statusEl) {
                        // Same classes the table rows use, so the modal and the
                        // list never disagree on how a status looks.
                        var badgeClass = 'status-badge status-inactive';
                        var dotClass = 'status-dot status-dot-inactive';
                        var dotStyle = '';

                        if (data.status === 'Active') {
                            badgeClass = 'status-badge status-active';
                            dotClass = 'status-dot status-dot-active';
                        } else if (data.status === 'Pending') {
                            badgeClass = 'status-badge';
                            dotClass = 'status-dot';
                            dotStyle = ' style="background-color:#d97706;"';
                        }

                        statusEl.innerHTML = '<span class="' + badgeClass + '">' +
                            '<span class="' + dotClass + '"' + dotStyle + '></span>' +
                            (data.status || '—') + '</span>';
                    }

                    var photo = document.getElementById('modalProfilePicture');
                    if (photo) {
                        // Prefer the exact profile picture URL returned by the
                        // controller, then the legacy key. A missing or broken file
                        // falls back to the clean placeholder rather than alt text.
                        var defaultAvatar = '/images/default-avatar.png';
                        var photoUrl = data.profilePictureUrl || data.photoUrl || defaultAvatar;
                        photo.onerror = function () {
                            this.onerror = null;
                            this.src = defaultAvatar;
                        };
                        photo.src = photoUrl;
                        photo.style.display = '';
                    }
                })
                .catch(function (error) {
                    if (typeof showToast === 'function') {
                        showToast(error.message || 'Could not load the profile details.', 'error');
                    }
                    hideBootstrapModal(modalEl);
                });
        }

        // ---- Delete confirmation -------------------------------------------
        function openDeleteUserModal(button) {
            var modalEl = document.getElementById('deleteUserConfirmModal');
            if (!modalEl) return;

            var id = button.getAttribute('data-user-id');
            var displayName = button.getAttribute('data-user-name');

            var idField = document.getElementById('deleteUserId');
            var nameLabel = document.getElementById('deleteUserName');

            if (idField) idField.value = id || '';
            if (nameLabel) nameLabel.textContent = displayName || 'this account';

            showBootstrapModal(modalEl);
        }

        document.addEventListener('DOMContentLoaded', function () {
            var presets = document.querySelectorAll('.lockout-preset');
            for (var i = 0; i < presets.length; i++) {
                presets[i].addEventListener('click', function () {
                    setLockoutPreset(this.getAttribute('data-hours'));
                });
            }

            var customField = document.getElementById('lockoutCustomHours');
            if (customField) {
                customField.addEventListener('input', function () {
                    var hoursField = document.getElementById('lockoutDurationHours');
                    if (hoursField) hoursField.value = this.value;
                });
            }

            var unblockBtn = document.getElementById('unblockUserBtn');
            if (unblockBtn) {
                unblockBtn.addEventListener('click', unlockUserNow);
            }

            // Guard the lockout form: a cleared or out-of-range duration would
            // otherwise bind as 0, which the controller reads as "unlock" - so a
            // typo would silently lift the block instead of applying it.
            var lockoutForm = document.getElementById('userLockoutForm');
            if (lockoutForm) {
                lockoutForm.addEventListener('submit', function (event) {
                    if (isUnlockingUser) {
                        // An explicit unlock - duration 0 is what the controller expects.
                        isUnlockingUser = false;
                        return;
                    }

                    var hoursField = document.getElementById('lockoutDurationHours');
                    var customField = document.getElementById('lockoutCustomHours');
                    var hours = parseInt(customField ? customField.value : (hoursField ? hoursField.value : ''), 10);

                    if (isNaN(hours) || hours < 1 || hours > 168) {
                        event.preventDefault();
                        if (typeof showToast === 'function') {
                            showToast('Enter a lock duration between 1 and 168 hours (7 days).', 'error');
                        }
                        return;
                    }

                    if (hoursField) hoursField.value = String(hours);
                });
            }
        });
    </script>
}
