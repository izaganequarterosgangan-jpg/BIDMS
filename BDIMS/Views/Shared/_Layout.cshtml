@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AntiforgeryService
@inject BDIMS.Services.BarangayProfileProvider BarangayProfile
@{
    // Signed-in user details, read from the claims that AccountController issues at
    // login. Reading them once per render keeps the sidebar widget in sync with
    // whoever is actually signed in, without a database round-trip.
    var currentUserName = BDIMS.Services.UserClaims.GetDisplayName(User);
    var currentUserRole = BDIMS.Services.UserClaims.GetRole(User);
    var currentUserInitials = BDIMS.Services.UserClaims.GetInitials(User);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BIDMS</title>
    <meta name="csrf-token" content="@AntiforgeryService.GetAndStoreTokens(Context).RequestToken" />
    <!-- Bootstrap 5 CSS (served from the vendored copy so the app works offline) -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BDIMS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" />

    <style>
            :root {
                --color-bg-main: #f8fafc;
                --color-card-bg: #ffffff;
                --color-border: #e2e8f0;
                --color-border-subtle: #f1f5f9;
                --color-text-main: #0f172a;
                --color-text-body: #334155;
                --color-text-muted: #64748b;
                --color-text-light: #94a3b8;
                --color-primary: #2563eb;
                /* Shared profile-badge palette. The sidebar footer badge (.avatar-gold)
                   and the top header badge (.header-avatar) must stay identical, so
                   both read these tokens instead of hard-coding their own colours. */
                --color-avatar-bg: #0F172A;
                --color-avatar-text: #FFFFFF;
                --color-accent-amber: #f59e0b;
                --color-accent-amber-light: #fffbe2;
                --color-accent-blue-light: #eff6ff;
                --color-accent-teal-light: #ccfbf1;
                --color-accent-purple: #8b5cf6;
                --color-accent-purple-light: #f3e8ff;
                --color-status-pending-bg: #fef3c7;
                --color-status-pending-text: #d97706;
                --color-status-processing-bg: #dbeafe;
                --color-status-processing-text: #2563eb;
                --color-status-ready-bg: #d1fae5;
                --color-status-ready-text: #059669;
                --color-status-released-bg: #f1f5f9;
                --color-status-released-text: #64748b;
                --radius-sm: 6px;
                --radius-md: 8px;
                --radius-lg: 12px;
            }

            body {
                background-color: var(--color-bg-main);
                font-family: system-ui, -apple-system, sans-serif;
                color: var(--color-text-body);
            }

            /* Sidebar styles moved to documents.css for consistent page look */

            /* TOP HEADER */
            .top-header {
                padding: 16px 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                background-color: var(--color-card-bg);
                border-bottom: 1px solid var(--color-border);
                margin: -1.5rem -1.5rem 1.5rem -1.5rem;
            }

            .header-title {
                font-size: 20px;
                font-weight: 700;
                color: var(--color-text-main);
                margin: 0;
            }

            .header-subtitle {
                font-size: 12px;
                color: var(--color-text-light);
                margin: 2px 0 0 0;
            }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .search-box-header {
                position: relative;
            }

            .search-icon-input {
                width: 16px;
                height: 16px;
                color: var(--color-text-light);
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
            }

            .search-input {
                padding: 8px 12px 8px 36px;
                background-color: var(--color-bg-main);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-md);
                font-size: 13px;
                width: 240px;
                outline: none;
            }

            .notification-button {
                position: relative;
                width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: var(--color-card-bg);
                border-radius: var(--radius-md);
                border: 1px solid var(--color-border);
                color: var(--color-text-muted);
                cursor: pointer;
            }

            /* small red badge showing unread count */
            .notif-badge {
                position: absolute;
                top: 4px;
                right: 4px;
                min-width: 18px;
                height: 18px;
                padding: 0 5px;
                background: #ef4444;
                color: #fff;
                font-size: 11px;
                font-weight: 700;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 999px;
                border: 2px solid var(--color-card-bg);
            }

            /* dropdown container */
            .notif-dropdown {
                position: absolute;
                top: 46px;
                right: 0;
                width: 340px;
                background: var(--color-card-bg);
                border: 1px solid var(--color-border);
                border-radius: 8px;
                box-shadow: 0 6px 18px rgba(15,23,42,0.12);
                z-index: 1100;
                max-height: 420px;
                overflow: hidden;
                display: none;
            }

            .notif-dropdown .header {
                padding: 12px 14px;
                border-bottom: 1px solid var(--color-border);
                display:flex; align-items:center; justify-content:space-between;
            }

            .notif-dropdown .items { max-height: 360px; overflow-y: auto; }

            .notif-item { padding: 12px 14px; border-bottom: 1px solid var(--color-border-subtle); cursor: pointer; display: flex; align-items: center; gap: 10px; }
            .notif-item.unread { background: var(--color-accent-blue-light); }
            .notif-item-content { flex: 1; min-width: 0; }
            .notif-item .title { font-weight:700; color:var(--color-text-main); }
            .notif-item .meta { font-size:12px; color:var(--color-text-muted); }
            .notif-view-btn { border:none; background:none; color:#0b194c; cursor:pointer; padding:6px; border-radius:8px; flex: 0 0 auto; line-height:1; }
            .notif-view-btn:hover { background:#e0e7ff; color:#152766; }
            .notif-item.read .notif-view-btn { color:#94a3b8; }
            .notif-empty { padding: 16px; color: var(--color-text-muted); }

            /* Top header profile badge. Mirrors .avatar-gold in site.css so the same
               user initials look identical in the sidebar footer and in the navbar. */
            .header-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background-color: var(--color-avatar-bg, #0F172A);
                color: var(--color-avatar-text, #FFFFFF);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 12px;
            }

            /* HERO / BANNER */
            .hero-card {
                background-color: var(--color-card-bg);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-lg);
                padding: 20px 24px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
            }

            .hero-eyebrow {
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.05em;
                color: var(--color-text-muted);
                margin-bottom: 4px;
                display: block;
            }

            .hero-card h3 {
                font-size: 15px;
                font-weight: 600;
                color: var(--color-text-main);
                margin: 0;
            }

            .hero-actions {
                display: flex;
                gap: 10px;
            }

            .primary-btn, .secondary-btn, .text-btn {
                border: none;
                cursor: pointer;
                border-radius: var(--radius-sm);
                font-size: 13px;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                padding: 8px 14px;
                text-decoration: none;
            }

            .primary-btn {
                background-color: var(--color-accent-amber);
                color: #ffffff;
            }

            .secondary-btn {
                background-color: var(--color-border-subtle);
                color: var(--color-text-body);
            }

            /* STATS GRID */
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 16px;
                margin-bottom: 20px;
            }

            .stat-card {
                background-color: var(--color-card-bg);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-lg);
                padding: 16px;
            }

            .stat-header {
                margin-bottom: 8px;
            }

            .stat-icon {
                width: 36px;
                height: 36px;
                border-radius: var(--radius-md);
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .stat-icon.blue {
                    background-color: var(--color-accent-blue-light);
                }

                .stat-icon.amber {
                    background-color: var(--color-accent-amber-light);
                }

                .stat-icon.teal {
                    background-color: var(--color-accent-teal-light);
                }

                .stat-icon.purple {
                    background-color: var(--color-accent-purple-light);
                }

            .stat-value {
                font-size: 22px;
                font-weight: 700;
                color: var(--color-text-main);
            }

            .stat-label {
                font-size: 12px;
                color: var(--color-text-muted);
                margin-top: 2px;
            }

            .stat-trend {
                margin-top: 6px;
                font-size: 11px;
                font-weight: 600;
            }

                .stat-trend.positive {
                    color: #10b981;
                }

                .stat-trend.warning {
                    color: var(--color-accent-amber);
                }

                .stat-trend.purple {
                    color: var(--color-accent-purple);
                }

            /* DASHBOARD GRID & PANELS */
            .dashboard-grid {
                display: grid;
                grid-template-columns: 2fr 1fr;
                gap: 20px;
                margin-bottom: 20px;
            }

            @@media (max-width: 992px) {
                .dashboard-grid {
                    grid-template-columns: 1fr;
                }
            }

            .panel-card {
                background-color: var(--color-card-bg);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-lg);
                padding: 20px;
            }

            .panel-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 16px;
            }

                .panel-header h3 {
                    font-size: 14px;
                    font-weight: 700;
                    color: var(--color-text-main);
                    margin: 0;
                }

                .panel-header p {
                    font-size: 11px;
                    color: var(--color-text-light);
                    margin: 2px 0 0 0;
                }

            .text-btn {
                background: transparent;
                color: var(--color-primary);
                padding: 0;
            }

            /* CHART CONTAINER FIX: Rigidly restricts Canvas Size */
            .chart-wrapper {
                position: relative;
                height: 240px;
                width: 100%;
            }

                .chart-wrapper canvas {
                    max-width: 100% !important;
                    max-height: 100% !important;
                }

            /* TABLES */
            .table-wrapper {
                overflow-x: auto;
            }

            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

                .data-table th {
                    text-align: left;
                    font-size: 10px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: var(--color-text-light);
                    padding: 10px 12px;
                    border-bottom: 1px solid var(--color-border-subtle);
                }

                .data-table td {
                    padding: 12px;
                    border-bottom: 1px solid var(--color-border-subtle);
                    color: var(--color-text-body);
                }

            .resident-cell {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .table-avatar {
                width: 26px;
                height: 26px;
                border-radius: 50%;
                background-color: var(--color-border);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 10px;
                font-weight: 700;
                color: var(--color-text-body);
            }

            /* STATUS PILLS */
            .status-pill {
                display: inline-block;
                padding: 3px 8px;
                border-radius: 12px;
                font-size: 11px;
                font-weight: 600;
            }

            .status-pending {
                background-color: var(--color-status-pending-bg);
                color: var(--color-status-pending-text);
            }

            .status-processing {
                background-color: var(--color-status-processing-bg);
                color: var(--color-status-processing-text);
            }

            .status-ready {
                background-color: var(--color-status-ready-bg);
                color: var(--color-status-ready-text);
            }

            .status-released {
                background-color: var(--color-status-released-bg);
                color: var(--color-status-released-text);
            }

            /* ACTIONS */
            .action-list {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .action-btn {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 12px;
                border-radius: var(--radius-md);
                background-color: var(--color-bg-main);
                border: 1px solid var(--color-border-subtle);
                color: var(--color-text-body);
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                text-decoration: none;
            }

            .action-icon {
                width: 28px;
                height: 28px;
                border-radius: var(--radius-sm);
                background-color: var(--color-card-bg);
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--color-border);
            }

            .text-purple {
                color: #8b5cf6 !important;
            }

            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.5);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 1050;
            }

                .modal-overlay.active {
                    display: flex;
                }

            /* Bootstrap hides .modal via its own stylesheet, so without that CSS every
               dialog on the page renders inline as visible body text. Keep the closed
               state working on its own. Bootstrap's own .modal.show (specificity 0,2,0)
               still wins over this 0,1,0 rule, and the scripts that open dialogs set an
               inline display, so opening behaviour is unaffected. */
            .modal {
                display: none;
            }

            .modal-card {
                background: white;
                padding: 24px;
                border-radius: 12px;
                max-width: 450px;
                width: 90%;
            }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="page-shell">
        <!-- Sidebar (documents-style) -->
        <aside class="sidebar">
            <div>
                <div class="sidebar-logo-container">
                    <div class="logo-badge">
                        <i class="bi bi-shield-check text-warning fs-4"></i>
                    </div>
                    <div>
                        <h1 class="brand-title">BIDMS</h1>
                        <p class="brand-subtitle">Barangay @BarangayProfile.Current.BarangayName @BarangayProfile.Current.Municipality, @BarangayProfile.Current.Province System</p>
                    </div>
                </div>

                <div class="nav-menu">
                    <p class="menu-section-title">Main Menu</p>
                @{
                        // Determine active route for sidebar highlighting
                        var currentController = Context.Request.RouteValues["controller"]?.ToString() ?? "";
                        var currentAction = Context.Request.RouteValues["action"]?.ToString() ?? "";
                    }
                    <nav class="nav-list">
                        <a asp-controller="Home" asp-action="Dashboard" class="nav-button @(currentController == "Home" && currentAction == "Dashboard" ? "active" : "")">
                            <div class="nav-button-left"><i class="bi bi-grid-fill"></i><span>Dashboard</span></div>
                        </a>
                        <a asp-controller="Home" asp-action="Residents" class="nav-button @(currentController == "Home" && currentAction == "Residents" ? "active" : "")">
                            <div class="nav-button-left"><i class="bi bi-people-fill"></i><span>Residents</span></div>
                        </a>
                        <a asp-controller="Home" asp-action="Documents" class="nav-button @(currentController == "Home" && currentAction == "Documents" ? "active" : "")">
                            <div class="nav-button-left"><i class="bi bi-file-earmark-text-fill"></i><span>Documents</span></div>
                        </a>
                        <a asp-controller="Home" asp-action="Certificates" class="nav-button @(currentController == "Home" && currentAction == "Certificates" ? "active" : "")">
                            <div class="nav-button-left"><i class="bi bi-award-fill"></i><span>Certificates</span></div>
                        </a>
                        <a asp-controller="Home" asp-action="Blotter" class="nav-button @(currentController == "Home" && currentAction == "Blotter" ? "active" : "")">
                            <div class="nav-button-left"><i class="bi bi-shield-lock-fill"></i><span>Blotter</span></div>
                        </a>
                        <a asp-controller="Home" asp-action="Announcements" class="nav-button @(currentController == "Home" && currentAction == "Announcements" ? "active" : "")">
                            <div class="nav-button-left"><i class="bi bi-megaphone-fill"></i><span>Announcements</span></div>
                        </a>
                        <a asp-controller="Home" asp-action="Reports" class="nav-button @(currentController == "Home" && currentAction == "Reports" ? "active" : "")">
                            <div class="nav-button-left"><i class="bi bi-bar-chart-fill"></i><span>Reports</span></div>
                        </a>
                        <a asp-controller="Home" asp-action="Settings" class="nav-button @(currentController == "Home" && currentAction == "Settings" ? "active" : "")">
                            <div class="nav-button-left"><i class="bi bi-gear-fill"></i><span>Settings</span></div>
                        </a>
                    </nav>
                </div>
            </div>

                <div class="sidebar-user">
                @* Anchoring the block keeps .user-profile's own flex layout, gap and the
                   sidebar's fixed width intact - the anchor only supplies the hit area. *@
                <a asp-controller="Account" asp-action="Profile" class="profile-badge-link sidebar-profile-link" title="My Profile">
                    <div class="user-profile">
                        <div class="avatar-gold">@currentUserInitials</div>
                        <div>
                            <p class="user-name">@currentUserName</p>
                            <p class="user-role">@currentUserRole</p>
                        </div>
                    </div>
                </a>
                <form asp-controller="Home" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-button" title="Log Out">
                        <i class="bi bi-box-arrow-right fs-5"></i>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Body -->
        <main class="main-content">
            @RenderBody()

            @* `app-footer` is namespaced on purpose: a bare `footer` class collides with
               the demo `.footer` rule Bootstrap compiles into BDIMS.styles.css, which
               positions that element absolutely and pulls it out of the content flow. *@
            <footer class="border-top app-footer text-muted px-4 py-3 bg-white mt-4">
                <div class="container-fluid p-0">
                    &copy; 2026 - BIDMS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </main>
    </div>

    <!-- Generic Modal Overlay -->
    <div class="modal-overlay" id="genericModal">
        <div class="modal-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0" id="modalTitle">Modal Title</h5>
                <button class="btn-close" onclick="closeModal()"></button>
            </div>
            <div id="modalBody"></div>
        </div>
    </div>

    <!-- Notification / Announcement Details Modal -->
    <div class="modal fade" id="notificationDetailsModal" tabindex="-1" aria-labelledby="notificationDetailsLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="notificationDetailsLabel">Announcement Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="notificationDetailsBody"></div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function openModal(title, bodyHtml) {
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalBody').innerHTML = bodyHtml;
        document.getElementById('genericModal').classList.add('active');
        }

        function closeModal() {
        document.getElementById('genericModal').classList.remove('active');
        }
    </script>
    @* Global toast container: reads TempData keys and shows a Bootstrap toast *@
    <div id="toastData" data-success="@(TempData["Success"] ?? TempData["SuccessMessage"] ?? String.Empty)" data-error="@(TempData["Error"] ?? TempData["ErrorMessage"] ?? String.Empty)" style="display:none"></div>

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
        <div id="globalToast" class="toast align-items-center text-bg-white border-0" role="alert" aria-live="assertive" aria-atomic="true" style="display:none;">
            <div class="d-flex">
                <div class="toast-body" id="globalToastBody"></div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script>
        (function () {
            try {
                var td = document.getElementById('toastData');
                if (!td) return;
                var success = td.dataset.success || '';
                var error = td.dataset.error || '';

                if (success) {
                    var toastEl = document.getElementById('globalToast');
                    var body = document.getElementById('globalToastBody');
                    body.innerText = success;
                    toastEl.classList.remove('text-bg-danger');
                    toastEl.classList.add('text-bg-success');
                    toastEl.style.display = 'block';
                    var bsToast = new bootstrap.Toast(toastEl, { delay: 4000 });
                    bsToast.show();
                }

                if (error) {
                    var toastEl = document.getElementById('globalToast');
                    var body = document.getElementById('globalToastBody');
                    body.innerText = error;
                    toastEl.classList.remove('text-bg-success');
                    toastEl.classList.add('text-bg-danger');
                    toastEl.style.display = 'block';
                    var bsToast = new bootstrap.Toast(toastEl, { delay: 6000 });
                    bsToast.show();
                }
            } catch (e) {
                console.error(e);
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>