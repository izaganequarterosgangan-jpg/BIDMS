@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set New Password - BIDMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="fp-page">
    @* Step three of three: reached only after the identity check passed. *@
    <main class="fp-card">
        <span class="fp-step">Step 3 of 3</span>
        <div class="fp-badge"><i class="bi bi-key"></i></div>

        <h1 class="fp-title">Set a new password</h1>
        <p class="fp-sub">
            Your new password must be at least 8 characters long.
        </p>

        <form asp-controller="Account" asp-action="ResetPassword" method="post">
            @* Explicit ids: asp-for would generate id="Password" and
               id="ConfirmPassword"; each eye toggle below points at the
               distinct id of its own field, matching the working pattern on
               the Login page (#passwordInput / #togglePassword). *@
            <label asp-for="Password" class="fp-label first"></label>
            <div class="fp-input-wrap">
                <input asp-for="Password" id="newPassword" class="fp-input" type="password" autocomplete="new-password" />
                <button type="button" class="fp-eye" id="toggleNewPassword" data-target="newPassword" aria-label="Show password">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="fp-error"></span>

            <label asp-for="ConfirmPassword" class="fp-label"></label>
            <div class="fp-input-wrap">
                <input asp-for="ConfirmPassword" id="confirmPassword" class="fp-input" type="password" autocomplete="new-password" />
                <button type="button" class="fp-eye" id="toggleConfirmPassword" data-target="confirmPassword" aria-label="Show password">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="fp-error"></span>

            <div asp-validation-summary="ModelOnly" class="fp-error"></div>

            <button type="submit" class="fp-btn">Reset password &rarr;</button>
        </form>

        <a class="fp-back" asp-controller="Account" asp-action="Login">&larr; Back to sign in</a>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Eye toggles for the two password fields. Each button's data-target
        // matches the explicit id of its input (newPassword / confirmPassword);
        // the previous markup pointed at ids asp-for never generated, so
        // getElementById found nothing and the handler exited without acting.
        document.querySelectorAll('.fp-eye[data-target]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                // The button is type="button", but preventDefault also stops the
                // click from ever falling through to a submit on other browsers
                // or if the markup is restyled later.
                e.preventDefault();

                var input = document.getElementById(btn.getAttribute('data-target'));
                if (!input) return;

                // Flip the field between hidden and visible...
                var revealing = input.type === 'password';
                input.type = revealing ? 'text' : 'password';

                // ...and swap the open eye (bi-eye) for the slashed eye
                // (bi-eye-slash) so the state is visible at a glance.
                var icon = btn.querySelector('.bi');
                if (icon) {
                    icon.classList.toggle('bi-eye', !revealing);
                    icon.classList.toggle('bi-eye-slash', revealing);
                }

                btn.setAttribute('aria-label', revealing ? 'Hide password' : 'Show password');
            });
        });
    </script>
</body>
</html>
