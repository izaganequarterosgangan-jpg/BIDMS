@model VerifyDetailsViewModel
@{
    ViewData["Title"] = "Verify Your Identity";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Identity - BIDMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="fp-page">
    @* Step two of three: all four details must match the registered profile
       before a new password can be chosen. *@
    <main class="fp-card">
        <span class="fp-step">Step 2 of 3</span>
        <div class="fp-badge"><i class="bi bi-person-check"></i></div>

        <h1 class="fp-title">Verify your identity</h1>
        <p class="fp-sub">
            Enter your personal details exactly as they appear on your
            registered account.
        </p>

        <form asp-controller="Account" asp-action="VerifyDetails" method="post">
            <label asp-for="FirstName" class="fp-label first"></label>
            <input asp-for="FirstName" class="fp-input" autocomplete="given-name" placeholder="e.g. Juan" />
            <span asp-validation-for="FirstName" class="fp-error"></span>

            <label asp-for="LastName" class="fp-label"></label>
            <input asp-for="LastName" class="fp-input" autocomplete="family-name" placeholder="e.g. Dela Cruz" />
            <span asp-validation-for="LastName" class="fp-error"></span>

            <label asp-for="DateOfBirth" class="fp-label"></label>
            <input asp-for="DateOfBirth" class="fp-input" type="date"
                   min="@DateTime.Today.AddYears(-100).ToString("yyyy-MM-dd")"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="DateOfBirth" class="fp-error"></span>

            <label asp-for="ContactNumber" class="fp-label"></label>
            <input asp-for="ContactNumber" class="fp-input" type="tel" autocomplete="tel" placeholder="e.g. 09171234567" />
            <span asp-validation-for="ContactNumber" class="fp-error"></span>

            @* "Details do not match" and any field errors land here. *@
            <div asp-validation-summary="ModelOnly" class="fp-error"></div>

            <button type="submit" class="fp-btn">Continue &rarr;</button>
        </form>

        <a class="fp-back" asp-controller="Account" asp-action="Login">&larr; Back to sign in</a>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
