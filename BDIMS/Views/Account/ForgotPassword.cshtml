@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - BIDMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="fp-page">
    @* Step one of three: locate the account by its registered email. *@
    <main class="fp-card">
        <span class="fp-step">Step 1 of 3</span>
        <div class="fp-badge"><i class="bi bi-search"></i></div>

        <h1 class="fp-title">Find your account</h1>
        <p class="fp-sub">
            Enter the email registered to your account. We will ask you to
            confirm your personal details before letting you set a new password.
        </p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <label asp-for="UsernameOrEmail" class="fp-label first"></label>
            <input asp-for="UsernameOrEmail" class="fp-input" autocomplete="username" placeholder="e.g. juan@email.com" autofocus />
            <span asp-validation-for="UsernameOrEmail" class="fp-error"></span>

            <div asp-validation-summary="ModelOnly" class="fp-error"></div>

            <button type="submit" class="fp-btn">Verify Account &rarr;</button>
        </form>

        <a class="fp-back" asp-controller="Account" asp-action="Login">&larr; Back to sign in</a>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
