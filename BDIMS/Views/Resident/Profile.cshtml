@model BDIMS.Models.ResidentDashboardViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_ResidentLayout";

    var fullName = string.IsNullOrWhiteSpace(Model?.ResidentName) ? "Resident" : Model.ResidentName;
    var initials = BDIMS.Services.UserClaims.GetInitials(User);
    var verified = string.Equals(Model?.VerificationStatus, "Verified resident", StringComparison.OrdinalIgnoreCase);
    var purok = string.IsNullOrWhiteSpace(Model?.Purok) ? "Not provided" : Model.Purok;
    var address = string.IsNullOrWhiteSpace(Model?.RegisteredAddress) ? "No address on file" : Model.RegisteredAddress;
    var firstName = string.IsNullOrWhiteSpace(Model?.FirstName) ? fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Resident" : Model.FirstName;
    var lastName = string.IsNullOrWhiteSpace(Model?.LastName) ? string.Empty : Model.LastName;
    var headerDate = DateTime.Now.ToString("dddd, MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);
}

<style>
    .resident-profile-page { width: 100%; max-width: 1440px; margin: 0 auto; }
    .resident-profile-page .profile-eyebrow { color: #2563eb; font-size: .7rem; font-weight: 800; letter-spacing: .1em; }
    .resident-profile-page .profile-card { background: #fff; border: 1px solid #e5eaf2; border-radius: 14px; box-shadow: 0 2px 8px rgba(15,23,42,.04); }
    .resident-profile-page .identity-avatar { width: 76px; height: 76px; border-radius: 50%; background: #dbeafe; color: #1d4ed8; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: 800; overflow: hidden; }
    .resident-profile-page .identity-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .resident-profile-page .identity-avatar-wrap { position: relative; display: inline-block; }
    .resident-profile-page .identity-avatar-edit { position: absolute; right: -2px; bottom: -2px; width: 28px; height: 28px; border-radius: 50%; border: 2px solid #fff; background: #2563eb; color: #fff; display: flex; align-items: center; justify-content: center; font-size: .8rem; padding: 0; cursor: pointer; }
    .resident-profile-page .identity-avatar-edit:hover { background: #1d4ed8; }
    .resident-profile-page .identity-avatar-edit[aria-busy="true"] { opacity: .6; cursor: progress; pointer-events: none; }
    .resident-profile-page .profile-photo-status { font-size: .78rem; margin: .5rem 0 0; }
    .resident-profile-page .profile-photo-status.is-error { color: #b91c1c; }
    .resident-profile-page .profile-photo-status.is-success { color: #047857; }
    .resident-profile-page .status-badge { border-radius: 999px; padding: .3rem .65rem; font-size: .7rem; font-weight: 800; }
    .resident-profile-page .status-badge.verified { background: #d1fae5; color: #047857; }
    .resident-profile-page .status-badge.unverified { background: #ffedd5; color: #c2410c; }
    .resident-profile-page .card-title { color: #0f172a; font-weight: 800; }
    .resident-profile-page .card-subtitle { color: #64748b; font-size: .8rem; }
    .resident-profile-page .field-label { color: #64748b; font-size: .68rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; margin-bottom: .35rem; }
    .resident-profile-page .readonly-field { background: #f8f9fa; border-color: #e2e8f0; color: #334155; }
    .resident-profile-page .readonly-field:disabled { opacity: 1; }
    .resident-profile-page .verification-box { border-radius: 10px; padding: .9rem; }
    .resident-profile-page .verification-box.verified { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }
    .resident-profile-page .verification-box.unverified { background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; }
    .resident-profile-page .quick-link { color: #1e293b; border: 1px solid #e2e8f0; border-radius: 10px; padding: .75rem .85rem; text-decoration: none; }
    .resident-profile-page .quick-link:hover { background: #f8fafc; border-color: #93c5fd; color: #1d4ed8; }
    .resident-profile-page .contact-note { color: #64748b; font-size: .78rem; }
</style>

<div class="resident-profile-page">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">My profile</h1>
            <p class="text-muted small mb-0">@headerDate · Bohol</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form asp-controller="Resident" asp-action="Requests" method="get" class="resident-search d-flex align-items-center gap-2 bg-white border rounded-3 px-2 py-1">
                <i class="bi bi-search text-muted"></i>
                <input name="searchQuery" class="form-control form-control-sm border-0 shadow-none" placeholder="Search services..." style="width: 175px;" />
            </form>
            @await Html.PartialAsync("_NotificationBell")
            <a asp-controller="Resident" asp-action="Profile" class="identity-avatar" data-user-avatar style="width:36px;height:36px;font-size:.75rem;text-decoration:none;" title="@fullName">
                @if (!string.IsNullOrWhiteSpace(Model?.ProfilePhotoUrl))
                {
                    <img src="@Model.ProfilePhotoUrl" alt="@fullName" />
                }
                else
                {
                    @initials
                }
            </a>
        </div>
    </div>

    <div class="mb-4">
        <div class="profile-eyebrow text-uppercase mb-1">YOUR RESIDENT ACCOUNT</div>
        <h2 class="h2 fw-bold mb-2">My resident profile</h2>
        <p class="text-muted mb-0">View your barangay record and keep your contact information up to date.</p>
    </div>

    @if (TempData["ProfileSuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i><span>@successMessage</span>
        </div>
    }
    @if (TempData["ProfileErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i><span>@errorMessage</span>
        </div>
    }

    <div class="row g-4 align-items-start">
        <div class="col-lg-4 col-xl-3">
            <div class="profile-card p-4 mb-4">
                <div class="identity-avatar-wrap mb-3">
                    <div class="identity-avatar" data-user-avatar aria-hidden="@(string.IsNullOrWhiteSpace(Model?.ProfilePhotoUrl) ? "true" : "false")">
                        @if (!string.IsNullOrWhiteSpace(Model?.ProfilePhotoUrl))
                        {
                            <img src="@Model.ProfilePhotoUrl" alt="@fullName" />
                        }
                        else
                        {
                            @initials
                        }
                    </div>
                    <button type="button"
                            class="identity-avatar-edit"
                            id="profilePhotoBtn"
                            data-max-bytes="@BDIMS.Services.ProfilePhotoStore.MaxBytes"
                            data-upload-url="@Url.Action("ChangePhoto", "Account")"
                            title="Upload a new profile photo"
                            aria-label="Upload a new profile photo">
                        <i class="bi bi-camera"></i>
                    </button>
                    <input type="file"
                           id="profilePhotoInput"
                           name="photo"
                           accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp"
                           aria-label="Choose a profile photo"
                           hidden />
                </div>
                <p class="profile-photo-status" id="profilePhotoStatus" role="status" aria-live="polite" hidden></p>
                <h3 class="h5 fw-bold mb-2">@fullName</h3>
                <span class="status-badge @(verified ? "verified" : "unverified")">@(verified ? "Verified resident" : "Unverified")</span>
                <div class="border-top mt-4 pt-3">
                    <div class="field-label">Purok</div>
                    <div class="fw-semibold mb-3">@purok</div>
                    <div class="field-label">Registered address</div>
                    <div class="text-muted small">@address</div>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-xl-9">
            <div class="profile-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <h3 class="card-title h5 mb-1">Barangay-verified information</h3>
                        <p class="card-subtitle mb-0">Read-only · Changes must be verified by the barangay office.</p>
                    </div>
                    <i class="bi bi-lock text-muted fs-5" title="Read-only"></i>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="field-label" for="verifiedFullName">Full name</label>
                        <input id="verifiedFullName" class="form-control readonly-field" value="@fullName" disabled />
                    </div>
                    <div class="col-12">
                        <label class="field-label" for="verifiedAddress">Registered address</label>
                        <input id="verifiedAddress" class="form-control readonly-field" value="@address" disabled />
                    </div>
                </div>
            </div>

            <div class="profile-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <h3 class="card-title h5 mb-1">Personal information</h3>
                        <p class="card-subtitle mb-0">Editable by you · Complete your personal details.</p>
                    </div>
                    <span class="badge text-bg-primary">Editable</span>
                </div>
                <form asp-controller="Resident" asp-action="SavePersonalInfo" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6 col-xl-3">
                            <label class="field-label" for="dateOfBirth">Date of birth</label>
                            <input id="dateOfBirth" name="dateOfBirth" type="date" class="form-control"
                                   value="@(Model?.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <label class="field-label" for="civilStatus">Civil status</label>
                            <select id="civilStatus" name="civilStatus" class="form-select">
                                <option value="">Select civil status</option>
                                @foreach (var option in new[] { "Single", "Married", "Widowed", "Separated", "Divorced", "Annulled" })
                                {
                                    <option value="@option" selected="@(string.Equals(Model?.CivilStatus, option, StringComparison.OrdinalIgnoreCase))">@option</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <label class="field-label" for="sex">Sex</label>
                            <select id="sex" name="sex" class="form-select">
                                <option value="">Select sex</option>
                                @foreach (var option in new[] { "Male", "Female" })
                                {
                                    <option value="@option" selected="@(string.Equals(Model?.Gender, option, StringComparison.OrdinalIgnoreCase))">@option</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <label class="field-label" for="suffix">Suffix (e.g., Jr., Sr., III)</label>
                            <input id="suffix" name="suffix" type="text" class="form-control" placeholder="Jr." value="@Model?.Suffix" maxlength="16" />
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <label class="field-label" for="Purok">Purok</label>
                            <input type="text" asp-for="Purok" class="form-control" placeholder="e.g. Purok 2" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-2"></i>Save personal information</button>
                    </div>
                </form>
            </div>

            <div class="profile-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <h3 class="card-title h5 mb-1">Contact information</h3>
                        <p class="card-subtitle mb-0">Editable by you · Add the details the barangay can use to contact you.</p>
                    </div>
                    <span class="badge text-bg-primary">Editable</span>
                </div>
                <form asp-controller="Account" asp-action="SaveProfile" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="FirstName" value="@firstName" />
                    <input type="hidden" name="LastName" value="@lastName" />
                    <input type="hidden" name="Role" value="Resident" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="field-label" for="contactNumber">Mobile number</label>
                            <input id="contactNumber" name="ContactNumber" type="tel" class="form-control" value="@Model?.ContactNumber" placeholder="Enter mobile number" />
                        </div>
                        <div class="col-md-6">
                            <label class="field-label" for="emailAddress">Email address</label>
                            <input id="emailAddress" name="Email" type="email" class="form-control" value="@Model?.Email" required />
                        </div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 pt-3 border-top">
                        <p class="contact-note mb-0">Contact details are currently unset. Saving here will not change your barangay-verified information.</p>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-2"></i>Save contact information</button>
                    </div>
                </form>
            </div>

            <div class="profile-card p-4">
                <h3 class="card-title h5 mb-3">Quick links</h3>
                <div class="row g-2">
                    <div class="col-md-4"><a asp-controller="Resident" asp-action="Requests" class="quick-link d-flex justify-content-between"><span><i class="bi bi-file-earmark-text text-primary me-2"></i>My Requests</span><i class="bi bi-chevron-right"></i></a></div>
                    <div class="col-md-4"><a asp-controller="Resident" asp-action="Requests" class="quick-link d-flex justify-content-between"><span><i class="bi bi-plus-square text-primary me-2"></i>New Document</span><i class="bi bi-chevron-right"></i></a></div>
                    <div class="col-md-4"><a asp-controller="Resident" asp-action="Announcements" class="quick-link d-flex justify-content-between"><span><i class="bi bi-megaphone text-primary me-2"></i>Announcements</span><i class="bi bi-chevron-right"></i></a></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Profile photo upload, posted to the existing Account/ChangePhoto endpoint (the
        // same secure pipeline the staff profile uses: the image is validated, stored in
        // the private App_Data photo folder and served back through
        // Account/ProfilePhoto). Scoped to the ids on this page so it cannot interfere
        // with the contact form or any other page.
        (function () {
            'use strict';

            var button = document.getElementById('profilePhotoBtn');
            var input = document.getElementById('profilePhotoInput');
            var status = document.getElementById('profilePhotoStatus');

            if (!button || !input || !status) {
                return;
            }

            // Mirror of ProfilePhotoStore.MaxBytes; the server is authoritative, this
            // only avoids sending a file that is obviously too large.
            var maxBytes = parseInt(button.getAttribute('data-max-bytes'), 10) || (5 * 1024 * 1024);

            var ALLOWED_EXTENSIONS = ['.png', '.jpg', '.jpeg', '.webp'];
            var ALLOWED_TYPES = ['image/png', 'image/jpeg', 'image/webp'];

            function antiforgeryToken() {
                var meta = document.querySelector('meta[name="csrf-token"]');
                var field = document.querySelector('input[name="__RequestVerificationToken"]');
                return (field && field.value) || (meta && meta.getAttribute('content')) || '';
            }

            function say(message, isError) {
                status.classList.remove('is-error');
                status.classList.remove('is-success');

                if (!message) {
                    status.hidden = true;
                    status.textContent = '';
                    return;
                }

                status.hidden = false;
                status.textContent = message;
                status.classList.add(isError ? 'is-error' : 'is-success');
            }

            function setBusy(isBusy) {
                button.setAttribute('aria-busy', isBusy ? 'true' : 'false');
                button.disabled = isBusy;
            }

            // Refreshes every avatar on the page (this card, the sidebar footer badge and
            // the header badge) from the same response, so a successful upload shows up
            // everywhere at once. Each badge keeps its own class and dimensions.
            function applyPhoto(url, altText) {
                document.querySelectorAll('[data-user-avatar]').forEach(function (badge) {
                    badge.textContent = '';
                    badge.removeAttribute('aria-hidden');

                    var img = document.createElement('img');
                    img.className = 'avatar-photo-image';
                    img.src = url;
                    img.alt = altText || '';
                    badge.appendChild(img);
                });
            }

            button.addEventListener('click', function () {
                input.click();
            });

            input.addEventListener('change', function () {
                var file = input.files && input.files[0];

                if (!file) {
                    return;
                }

                // Reset first so picking the same file twice still fires a change event.
                input.value = '';

                var dot = file.name.lastIndexOf('.');
                var extension = dot >= 0 ? file.name.substring(dot).toLowerCase() : '';

                if (ALLOWED_EXTENSIONS.indexOf(extension) === -1) {
                    say('Please choose a .png, .jpg, .jpeg or .webp image file.', true);
                    return;
                }

                if (file.type && ALLOWED_TYPES.indexOf(file.type.toLowerCase()) === -1) {
                    say('That file is not an image. Please choose an image file.', true);
                    return;
                }

                if (file.size > maxBytes) {
                    say('That photo is larger than 5 MB. oPlease choose a smaller image.', true);
                    return;
                }

                var form = new FormData();
                form.append('photo', file);

                setBusy(true);
                say('Uploading your photo...', false);

                fetch(button.getAttribute('data-upload-url'), {
                    method: 'POST',
                    // Token travels in the header (Program.cs binds this name to the
                    // antiforgery token): the body is FormData, which a hidden field
                    // cannot be appended to from script.
                    headers: {
                        'RequestVerificationToken': antiforgeryToken(),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: form
                })
                    .then(function (response) {
                        return response.json()
                            .catch(function () {
                                return {
                                    success: false,
                                    error: response.ok
                                        ? 'The server returned an unexpected response.'
                                        : 'Upload failed (HTTP ' + response.status + '). Please try again.'
                                };
                            });
                    })
                    .then(function (payload) {
                        if (!payload || !payload.success) {
                            say((payload && payload.error) || 'Upload failed. Please try again.', true);
                            return;
                        }

                        applyPhoto(payload.url, '');
                        say('Profile photo updated successfully.', false);
                    })
                    .catch(function () {
                        say('Upload failed. Please check your connection and try again.', true);
                    })
                    .then(function () {
                        setBusy(false);
                    });
            });
        })();
    </script>
}
