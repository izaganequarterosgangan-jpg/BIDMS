                            No @paymentMethodName QR code has been uploaded by the barangay yet.
                        </div>
                    </div>
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="d-flex justify-content-between gap-3 mb-2">
                            <span class="text-muted small">Account name</span>
                            <strong class="small text-end" id="paymentAccountName">@ViewBag.GCashAccountName</strong>
                        </div>
                        <div class="d-flex justify-content-between gap-3">
                            <span class="text-muted small">Mobile number</span>
                            <strong class="small text-end" id="paymentAccountNumber">@ViewBag.GCashAccountNumber</strong>
                        </div>
                    </div>
                    <p class="small text-muted mt-3 mb-0">
                        Scan the QR code or send the exact amount using @paymentMethodName to the account above, then keep your receipt for verification.
                    </p>

                    <hr class="my-3" />
                    <h6 class="fw-bold mb-3">Submit payment proof</h6>
                    <div class="mb-3">
                        <label for="paymentReferenceNumber" class="form-label small fw-semibold">@paymentMethodName Reference Number</label>
                        <input type="text" class="form-control" id="paymentReferenceNumber"
                               name="referenceNumber" maxlength="50" autocomplete="off" required />
                    </div>
                    <div class="mb-3">
                        <label for="paymentReceiptImage" class="form-label small fw-semibold">Attach Receipt Image</label>
                        <input type="file" class="form-control" id="paymentReceiptImage"
                               name="receiptImage" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" required />
                    </div>
                    <div class="mb-0">
                        <label for="paymentNote" class="form-label small fw-semibold">Short Note</label>
                        <input type="text" class="form-control" id="paymentNote"
                               name="paymentNote" maxlength="120" placeholder="Max 1 sentence" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check2-circle me-1"></i>Submit Payment Proof
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

