<div class="modal fade" id="residentInboxModal" tabindex="-1" aria-labelledby="residentInboxModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="residentInboxModalLabel">
                    <i class="bi bi-inbox-fill me-2"></i>Inbox / Attachment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between gap-3 mb-2">
                    <span class="text-muted small">Request</span>
                    <strong class="small text-end" id="inboxModalRequestNo"></strong>
                </div>
                <div class="d-flex justify-content-between gap-3 mb-3">
                    <span class="text-muted small">Status</span>
                    <strong class="small text-end" id="inboxModalStatus"></strong>
                </div>
<label class="form-label small fw-semibold">Certificate Note</label>
                 <div id="inboxModalAdminReply"
                      class="border rounded-3 p-3 bg-light small mb-3"
                      style="white-space: pre-wrap; min-height: 90px;"></div>
                <div id="inboxPdfContainer" class="border rounded-3 overflow-hidden" style="display: none;">
                    <iframe id="inboxPdfFrame"
                            class="w-100"
                            style="height: 500px; border: none;"
                            title="Document PDF Preview">
                    </iframe>
                </div>
                <div id="inboxNoPdf" class="text-center py-4 text-muted" style="display: none;">
                    <i class="bi bi-file-earmark-x fs-1 d-block mb-2"></i>
                    No PDF attachment available for this request.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <a id="inboxDownloadBtn" class="btn btn-primary" href="#" download style="display: none;">
                    <i class="bi bi-download me-1"></i>Download PDF
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function openResidentInboxModal(button) {
        var modalEl = document.getElementById('residentInboxModal');
        if (!modalEl) return;

        var requestNo = button.getAttribute('data-request-no') || '';
        var documentName = button.getAttribute('data-document') || '';
        var status = button.getAttribute('data-status') || '';
        var certificateNote = (button.getAttribute('data-certificate-note') || '').trim();
        var pdfUrl = button.getAttribute('data-pdf-url') || '';

        document.getElementById('inboxModalRequestNo').textContent = requestNo || '-';
        document.getElementById('inboxModalStatus').textContent = status || '-';
        document.getElementById('inboxModalAdminReply').textContent =
            certificateNote || 'No note from the Barangay Secretary.';

        var pdfContainer = document.getElementById('inboxPdfContainer');
        var pdfFrame = document.getElementById('inboxPdfFrame');
        var noPdf = document.getElementById('inboxNoPdf');
        var downloadBtn = document.getElementById('inboxDownloadBtn');

        if (pdfUrl) {
            pdfFrame.src = pdfUrl;
            pdfContainer.style.display = 'block';
            noPdf.style.display = 'none';
            downloadBtn.href = pdfUrl;
            downloadBtn.download = (documentName || 'document') + '.pdf';
            downloadBtn.style.display = 'inline-flex';
        } else {
            pdfContainer.style.display = 'none';
            noPdf.style.display = 'block';
            downloadBtn.style.display = 'none';
        }

        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            new bootstrap.Modal(modalEl).show();
        } else {
            modalEl.classList.add('show');
            modalEl.style.display = 'block';
            modalEl.setAttribute('aria-hidden', 'false');
        }
    }

    function openResidentPaymentStatusModal(button) {
        var modalEl = document.getElementById('residentPaymentStatusModal');
        if (!modalEl) return;

        var requestNo = button.getAttribute('data-request-no') || '';
        var status = button.getAttribute('data-status') || '';
        var reply = (button.getAttribute('data-admin-reply') || '').trim();

        document.getElementById('resModalRequestNo').textContent = requestNo || '-';
        document.getElementById('resModalStatus').textContent = status || '-';
        document.getElementById('resModalAdminReply').textContent =
            reply || 'No reply from the Barangay Secretary yet.';

        // Opening the feedback acknowledges the secretary's reply: drop the red dot
        // straight away and clear the flag server-side so it stays gone until the
        // secretary sends another update.
        var badge = button.querySelector('.unread-reply-badge');
        if (badge) {
            badge.remove();
        }
        markReplyAsRead(requestNo);

        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    // Tells the server the resident has read the secretary's reply. Fire-and-forget:
    // a failed call must never keep the feedback modal from opening.
    function markReplyAsRead(requestId) {
        if (!requestId) return;

        var body = new FormData();
        body.append('requestId', requestId);

        var headers = { 'X-Requested-With': 'XMLHttpRequest' };
        var tokenMeta = document.querySelector('meta[name="csrf-token"]');
        if (tokenMeta) {
            headers['RequestVerificationToken'] = tokenMeta.getAttribute('content');
        }

        fetch('/Resident/MarkReplyAsRead', {
            method: 'POST',
            headers: headers,
            body: body
        }).catch(function () { /* non-fatal */ });
    }

    // Withdraws a still-pending request. The confirm dialog is the first gate;
    // the server re-checks ownership and the Pending status before writing
    // "Cancelled", so a stale row can never cancel a processed request.
    function cancelResidentRequest(button) {
        var requestNo = button.getAttribute('data-request-no') || '';
        var documentName = button.getAttribute('data-document') || 'this request';
        if (!requestNo) return;

        if (!confirm('Are you sure you want to cancel ' + documentName + '?')) {
            return;
        }

        var body = new FormData();
        body.append('requestId', requestNo);

        var headers = { 'X-Requested-With': 'XMLHttpRequest' };
        var tokenMeta = document.querySelector('meta[name="csrf-token"]');
        if (tokenMeta) {
            headers['RequestVerificationToken'] = tokenMeta.getAttribute('content');
        }

        button.disabled = true;

        fetch('/Resident/CancelRequest', {
            method: 'POST',
            headers: headers,
            body: body
        })
            .then(function (response) { return response.json(); })
            .then(function (result) {
                if (result && result.success) {
                    window.location.reload();
                    return;
                }
                button.disabled = false;
                alert((result && result.message) || 'Unable to cancel this request.');
            })
            .catch(function () {
                button.disabled = false;
                alert('Something went wrong while cancelling the request. Please try again.');
            });
    }

    // Deletes a cancelled request from the list. Only cancelled rows render
    // this button, and the server re-checks the status, so a live request can
    // never be removed through this endpoint.
    function deleteResidentRequest(button) {
        var requestNo = button.getAttribute('data-request-no') || '';
        if (!requestNo) return;

        if (!confirm('Are you sure you want to delete this cancelled request?')) {
            return;
        }

        var body = new FormData();
        body.append('requestId', requestNo);

        var headers = { 'X-Requested-With': 'XMLHttpRequest' };
        var tokenMeta = document.querySelector('meta[name="csrf-token"]');
        if (tokenMeta) {
            headers['RequestVerificationToken'] = tokenMeta.getAttribute('content');
        }

        button.disabled = true;

        fetch('/Resident/DeleteRequest', {
            method: 'POST',
            headers: headers,
            body: body
        })
            .then(function (response) { return response.json(); })
            .then(function (result) {
                if (result && result.success) {
                    window.location.reload();
                    return;
                }
                button.disabled = false;
                alert((result && result.message) || 'Unable to delete this request.');
            })
            .catch(function () {
                button.disabled = false;
                alert('Something went wrong while deleting the request. Please try again.');
            });
    }

    function openEditRequestModal(button) {
        var modalEl = document.getElementById('editRequestModal');
        if (!modalEl) return;

        var status = (button.getAttribute('data-status') || '').trim();
        if (status.toLowerCase() !== 'pending') {
            return;
        }

        var form = document.getElementById('editRequestForm');
        var requestIdField = document.getElementById('editRequestId');
        var categoryField = document.getElementById('editPurposeCategory');
        var remarksField = document.getElementById('editSpecificRemarks');
        var claimField = document.getElementById('editClaimFormat');
        var label = document.getElementById('editRequestLabel');

        var requestId = button.getAttribute('data-request-id') || '';
        var category = button.getAttribute('data-purpose-category') || '';
        var remarks = button.getAttribute('data-specific-remarks') || '';
        var claimFormat = button.getAttribute('data-claim-format') || 'Printed Hard Copy';

        if (form) form.reset();
        if (requestIdField) requestIdField.value = requestId;
        if (remarksField) remarksField.value = remarks;

        function selectValue(select, value) {
            if (!select) return;

            var found = false;
            for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value === value) {
                    found = true;
                    break;
                }
            }

            if (!found && value) {
                var option = document.createElement('option');
                option.value = value;
                option.textContent = value;
                select.appendChild(option);
            }

            select.value = value;
        }

        selectValue(categoryField, category);
        selectValue(claimField, claimFormat || 'Printed Hard Copy');

        if (label) {
            label.textContent = requestId
                ? 'Updating ' + requestId + '. Only pending requests can be changed.'
                : 'Only pending requests can be changed.';
        }

        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            new bootstrap.Modal(modalEl).show();
        } else {
            modalEl.classList.add('show');
            modalEl.style.display = 'block';
            modalEl.setAttribute('aria-hidden', 'false');
        }
    }
</script>

<script>
    function openPaymentModal(button) {
        var modalEl = document.getElementById('paymentModal');
        if (!modalEl) return;

        var qrUrl = @Html.Raw(Json.Serialize(ViewBag.GCashQrUrl ?? string.Empty));
        var accountName = @Html.Raw(Json.Serialize(ViewBag.GCashAccountName ?? string.Empty));
        var accountNumber = @Html.Raw(Json.Serialize(ViewBag.GCashAccountNumber ?? string.Empty));

        var image = document.getElementById('paymentQrImage');
        var missing = document.getElementById('paymentQrMissing');
        var nameLabel = document.getElementById('paymentAccountName');
        var numberLabel = document.getElementById('paymentAccountNumber');
        var requestLabel = document.getElementById('paymentRequestLabel');
        var requestIdField = document.getElementById('paymentProofRequestId');
        var proofForm = document.getElementById('paymentProofForm');
        var requestNo = button.getAttribute('data-request-no') || '';

        if (proofForm) proofForm.reset();
        if (requestIdField) requestIdField.value = requestNo;

        if (qrUrl) {
            image.src = qrUrl;
            image.style.display = 'block';
            missing.style.display = 'none';
        } else {
            image.removeAttribute('src');
            image.style.display = 'none';
            missing.style.display = '';
        }

        if (nameLabel) nameLabel.textContent = accountName || 'Not provided';
        if (numberLabel) numberLabel.textContent = accountNumber || 'Not provided';

        if (requestLabel) {
            var documentName = button.getAttribute('data-document') || 'Document request';
            requestLabel.textContent = requestNo
                ? documentName + ' - ' + requestNo
                : documentName;
        }

        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            new bootstrap.Modal(modalEl).show();
        } else {
            modalEl.classList.add('show');
            modalEl.style.display = 'block';
            modalEl.setAttribute('aria-hidden', 'false');
        }
    }
</script>

<script>
    (() => {
        const table = document.getElementById('requestsTable');
        const search = document.getElementById('requestSearch');
        const countText = document.getElementById('requestCountText');
        const buttons = document.querySelectorAll('[data-filter]');
        if (!table) return;
        let activeFilter = 'all';
        const applyFilters = () => {
            const query = (search?.value || '').trim().toLowerCase();
            const rows = Array.from(table.querySelectorAll('tbody tr'));
            let visible = 0;
            rows.forEach(row => {
                const matchesStatus = activeFilter === 'all' || row.dataset.status === activeFilter;
                const matchesSearch = !query || (row.dataset.search || '').toLowerCase().includes(query);
                const show = matchesStatus && matchesSearch;
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            if (countText) countText.textContent = `Showing ${visible ? 1 : 0}-${visible} of ${rows.length} requests`;
        };
        buttons.forEach(button => button.addEventListener('click', () => {
            activeFilter = button.dataset.filter || 'all';
            buttons.forEach(item => { item.classList.toggle('active', item === button); item.classList.toggle('btn-outline-secondary', item !== button); });
            applyFilters();
        }));
        search?.addEventListener('input', applyFilters);

        // The header "Search services..." bar routes here as ?search=<query>; the in-page
        // form (and the older header submit) use ?searchQuery=. Either way, pre-fill the
        // page search box and run the filter once on load so the results are already
        // narrowed when the page appears.
        const initial = new URLSearchParams(window.location.search);
        const initialQuery = initial.get('search') || initial.get('searchQuery');
        if (initialQuery && search) {
            search.value = initialQuery;
            applyFilters();
        }
    })();
</script>

<script>
    // New-request profile autofill. The four identity fields (name, age, purok, address)
    // come from the logged-in resident's saved profile, passed through view data; the
    // document type, purpose category and remarks are intentionally left untouched so
    // they must be chosen fresh for every request.
    (() => {
        const button = document.getElementById('autofillProfileBtn');
        if (!button) return;

        const fields = {
            residentName: button.getAttribute('data-profile-name') || '',
            residentAge: button.getAttribute('data-profile-age') || '',
            residentPurok: button.getAttribute('data-profile-purok') || '',
            residentAddress: button.getAttribute('data-profile-address') || ''
        };

        const apply = () => {
            Object.keys(fields).forEach(id => {
                const input = document.getElementById(id);
                if (input) input.value = fields[id];
            });
        };

        // Auto-prefill on load so the fields are already populated the first time the
        // panel is opened.
        apply();

        // Explicit re-fill always overwrites, letting a resident restore the saved values
        // after clearing or mistyping a field.
        button.addEventListener('click', apply);
    })();
</script>

<script>
    // Dynamic certificate fee box. Each option carries the admin-configured fee
    // from Settings > Certificates & Fees (data-fee, e.g. "50.00"); on selection
    // the badge shows it formatted to 2 decimals as "₱ 50.00". Hidden again when
    // no document is chosen.
    function updateCertificateFee(select) {
        var sel = select || document.getElementById('documentType');
        var box = document.getElementById('certificateFeeBadge');
        var text = document.getElementById('certificateFeeText');
        if (!sel || !box || !text) return;

        var option = sel.selectedOptions && sel.selectedOptions[0];
        var raw = option ? (option.getAttribute('data-fee') || '') : '';
        if (!option || !option.value || raw === '') {
            box.style.display = 'none';
            return;
        }

        var fee = parseFloat(raw);
        if (isNaN(fee) || fee < 0) fee = 0;
        text.textContent = '₱ ' + fee.toFixed(2);
        box.style.display = 'inline-flex';
    }

    // Run once on load so a pre-selected document (e.g. after validation errors)
    // still shows its fee without requiring a change event.
    document.addEventListener('DOMContentLoaded', function () {
        updateCertificateFee(document.getElementById('documentType'));
    });
</script>
