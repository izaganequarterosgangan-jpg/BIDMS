@model BDIMS.Models.ResidentDashboardViewModel
@{
    ViewData["Title"] = "My Requests";
    Layout = "_ResidentLayout";

    var requests = Model?.RecentRequests ?? new List<BDIMS.Models.ResidentRequestItem>();
    var headerDate = DateTime.Now.ToString("dddd, MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);
    var fullName = string.IsNullOrWhiteSpace(Model?.ResidentName) ? "Resident" : Model.ResidentName;
    var initials = BDIMS.Services.UserClaims.GetInitials(User);
    var allCount = requests.Count;
    var pendingCount = Model?.PendingRequestsCount ?? 0;
    var readyCount = Model?.ReadyForPickupCount ?? 0;
    var rejectedCount = requests.Count(r => IsRejected(r.Status));
    var certificateTypes = Model?.AvailableCertificateTypes ?? new List<BDIMS.Models.CertificateRule>();
    var paymentMethodName = (ViewBag.PaymentMethodName as string) ?? "GCash";

    bool IsRejected(string? status)
    {
        var value = (status ?? string.Empty).Trim();
        return value.Equals("Rejected", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Declined", StringComparison.OrdinalIgnoreCase);
    }

    bool IsCancelled(string? status)
    {
        var value = (status ?? string.Empty).Trim();
        return value.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
            || value.Equals("Canceled", StringComparison.OrdinalIgnoreCase);
    }

    string StatusClass(string? status)
    {
        if (IsRejected(status)) return "request-status-rejected";
        if (IsCancelled(status)) return "request-status-cancelled";
        var value = (status ?? string.Empty).Trim().ToLowerInvariant();
        return value is "ready for pickup" or "approved" or "ready" or "ready for download" ? "request-status-ready"
            : value is "pending" or "in review" or "processing" ? "request-status-pending"
            : "request-status-issued";
    }

    string StatusLabel(string? status)
    {
        var value = (status ?? string.Empty).Trim();
        if (string.Equals(value, "Approved", StringComparison.OrdinalIgnoreCase)) return "Ready for pickup";
        if (string.Equals(value, "Released", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, "Completed", StringComparison.OrdinalIgnoreCase)) return "Issued";
        return string.IsNullOrWhiteSpace(value) ? "Pending" : value;
    }
}

<style>
    .resident-requests-page { width: 100%; max-width: 1440px; margin: 0 auto; }
    /* Fee badge under the Document Type select: shows the admin-configured fee
       for the chosen certificate (e.g. "₱ 50.00") in 2 decimals. */
    .certificate-fee-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        padding: 6px 12px;
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #d1fae5;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }
    .certificate-fee-badge i { font-size: .9rem; }
    .resident-requests-page .requests-eyebrow { color: #2563eb; font-size: .7rem; font-weight: 800; letter-spacing: .1em; }
    .resident-requests-page .request-card { background: #fff; border: 1px solid #e9ecef; border-radius: 12px; box-shadow: 0 2px 8px rgba(15,23,42,.04); }
    .resident-requests-page .metric-card { height: 100%; padding: 1rem; display: flex; align-items: center; gap: .8rem; }
    .resident-requests-page .metric-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .resident-requests-page .metric-icon.pending { background: #fef3c7; color: #b45309; }
    .resident-requests-page .metric-icon.ready { background: #d1fae5; color: #047857; }
    .resident-requests-page .metric-icon.issued { background: #dbeafe; color: #1d4ed8; }
    .resident-requests-page .metric-count { color: #0f172a; font-size: 1.45rem; font-weight: 800; line-height: 1; }
    .resident-requests-page .metric-title { color: #0f172a; font-size: .82rem; font-weight: 800; }
    .resident-requests-page .metric-subtitle { color: #64748b; font-size: .72rem; }
    .resident-requests-page .request-alert { background: #eef4ff; border: 1px solid #cfe0ff; border-radius: 12px; color: #1e3a8a; }
    .resident-requests-page .request-alert i { font-size: 1.25rem; }
    .resident-requests-page .toolbar-search { max-width: 330px; }
    .resident-requests-page .filter-pill { border-radius: 999px; font-size: .75rem; font-weight: 700; white-space: nowrap; }
    .resident-requests-page .filter-pill.active { background: #2563eb; border-color: #2563eb; color: #fff; }
    .resident-requests-page .request-table th { color: #64748b; font-size: .68rem; letter-spacing: .06em; white-space: nowrap; }
    .resident-requests-page .request-table td { padding-top: 1rem; padding-bottom: 1rem; }
    .resident-requests-page .document-icon { width: 38px; height: 38px; border-radius: 10px; background: #eef2ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .resident-requests-page .request-title { color: #0f172a; font-weight: 800; }
    .resident-requests-page .request-meta { color: #64748b; font-size: .72rem; }
    .resident-requests-page .request-status { border-radius: 999px; padding: .3rem .65rem; font-size: .7rem; font-weight: 800; white-space: nowrap; }
    .resident-requests-page .request-status-ready { background: #d1fae5; color: #047857; }
    .resident-requests-page .request-status-pending { background: #fef3c7; color: #b45309; }
    .resident-requests-page .request-status-issued { background: #dbeafe; color: #1d4ed8; }
    .resident-requests-page .request-status-rejected { background: #fee2e2; color: #b91c1c; }
    .resident-requests-page .request-status-cancelled { background: #f1f5f9; color: #475569; }
    /* Red dot over the feedback icon: the secretary replied and the resident has
       not opened the feedback yet. Removed from the DOM once they open it. */
    .resident-requests-page .unread-reply-badge { width: 9px; height: 9px; padding: 0; font-size: 0; line-height: 0; }
    .resident-requests-page .details-link { color: #2563eb; font-size: .78rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
    .resident-requests-page .details-link:hover { color: #1d4ed8; text-decoration: underline; }
    .resident-requests-page .instruction-card { height: 100%; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem; }
    .resident-requests-page .instruction-card h3 { color: #0f172a; font-size: .95rem; font-weight: 800; }
    .resident-requests-page .instruction-card p { color: #64748b; font-size: .8rem; line-height: 1.55; margin-bottom: 0; }
    .resident-requests-page .empty-state { color: #64748b; padding: 2rem 1rem; text-align: center; }
    @@media (max-width: 767.98px) {
        .resident-requests-page .toolbar-search { max-width: none; width: 100%; }
        .resident-requests-page .filter-pills { overflow-x: auto; flex-wrap: nowrap !important; padding-bottom: .25rem; }
    }
</style>

<div class="resident-requests-page">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">My requests</h1>
            <p class="text-muted small mb-0">@headerDate · Bohol</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form asp-controller="Resident" asp-action="Requests" method="get" class="resident-search d-flex align-items-center gap-2 bg-white border rounded-3 px-2 py-1">
                <i class="bi bi-search text-muted"></i>
                <input name="searchQuery" class="form-control form-control-sm border-0 shadow-none" placeholder="Search services..." style="width:175px;" />
            </form>
            @await Html.PartialAsync("_NotificationBell")
            <a asp-controller="Resident" asp-action="Profile" class="resident-avatar" title="@fullName">@initials</a>
        </div>
    </div>

    <div class="mb-4">
        <div class="requests-eyebrow text-uppercase mb-1">YOUR DOCUMENT REQUESTS</div>
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <h2 class="h2 fw-bold mb-2">Track your requests</h2>
                <p class="text-muted mb-0">View the status of every document you have requested from your barangay.</p>
            </div>
            <button type="button" class="btn btn-primary fw-bold" data-bs-toggle="collapse" data-bs-target="#newRequestPanel" aria-expanded="false" aria-controls="newRequestPanel">+ Request Document</button>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    }

    <div class="collapse mb-4" id="newRequestPanel">
        <div class="request-card p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h3 class="h5 fw-bold mb-1">Submit a new document request</h3>
                    <p class="text-muted small mb-3">Choose a document and provide the purpose for your barangay review.</p>
                </div>
                <button type="button"
                        class="btn btn-outline-primary btn-sm mb-3"
                        id="autofillProfileBtn"
                        data-profile-name="@(ViewData["ProfileFullName"])"
                        data-profile-age="@(ViewData["ProfileAge"])"
                        data-profile-purok="@(ViewData["ProfilePurok"])"
                        data-profile-address="@(ViewData["ProfileAddress"])"
                        title="Fill the name, age, purok and address fields from your saved profile">
                    <i class="bi bi-person-lines-fill me-1"></i>Autofill from profile
                </button>
            </div>
            <form asp-controller="Resident" asp-action="SubmitRequest" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label small fw-bold" for="residentName">Resident name</label>
                    <input class="form-control" id="residentName" value="@Model?.ResidentName" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold" for="residentAge">Age</label>
                    <input type="number" name="Age" class="form-control" id="residentAge" value="@(Model?.Age?.ToString() ?? string.Empty)" placeholder="e.g. 25" min="0" max="150" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold" for="residentPurok">Purok</label>
                    <input name="Purok" class="form-control" id="residentPurok" value="@Model?.Purok" placeholder="e.g. Purok 2" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold" for="residentAddress">Address</label>
                    <input name="Address" class="form-control" id="residentAddress" value="@Model?.RegisteredAddress" placeholder="e.g. Governor Boyles, Ubay, Bohol" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold" for="documentType">Document type</label>
                    <select class="form-select" name="DocumentType" id="documentType" required onchange="updateCertificateFee(this)">
                        <option value="" data-fee="">Choose a document</option>
                        @foreach (var certificate in (ViewBag.Certificates as List<BDIMS.Models.CertificateRule>) ?? certificateTypes)
                        {
                            <option value="@certificate.Type" data-fee="@certificate.Fee.ToString("F2")">@certificate.Type</option>
                        }
                    </select>
                    @* Fee badge: shows the exact admin-configured fee for the chosen
                       certificate (e.g. "₱ 50.00") in 2 decimals. Hidden until a
                       document is selected; updateCertificateFee() drives it. *@
                    <div id="certificateFeeBadge" class="certificate-fee-badge" style="display:none;">
                        <i class="bi bi-cash-coin"></i>
                        <span>Fee: <strong id="certificateFeeText">₱ 0.00</strong></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold" for="purposeCategory">Purpose category</label>
                    <select class="form-select" name="PurposeCategory" id="purposeCategory" required>
                        <option value="">Choose a category</option>
                        <option>Employment</option>
                        <option>Scholarship / School Requirement</option>
                        <option>Medical Assistance</option>
                        <option>Financial Assistance</option>
                        <option>Business / Legal</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-bold" for="purpose">Specific remarks</label>
                    <textarea class="form-control" name="SpecificRemarks" id="purpose" rows="3" placeholder="Describe the purpose of your request..."></textarea>
                </div>
                @* Claim format: how the resident wants to receive the document.
                   Bound to DocumentRequestModel.FulfillmentMode; the controller
                   normalizes anything unexpected to the printed hard copy. *@
                <div class="col-12">
                    <label class="form-label small fw-bold">Claim format</label>
                    <div class="d-flex flex-column gap-2">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="FulfillmentMode" id="fulfillmentDigital" value="Digital Soft Copy" required>
                            <label class="form-check-label" for="fulfillmentDigital">
                                <strong>Digital Soft Copy</strong> — downloadable PDF, for remote residents.
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="FulfillmentMode" id="fulfillmentPrinted" value="Printed Hard Copy" required>
                            <label class="form-check-label" for="fulfillmentPrinted">
                                <strong>Printed Hard Copy</strong> — in-person pickup at the Barangay Hall.
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light border" data-bs-toggle="collapse" data-bs-target="#newRequestPanel">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Request <i class="bi bi-arrow-right ms-1"></i></button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6"><div class="request-card metric-card"><div class="metric-icon pending"><i class="bi bi-clock-history"></i></div><div><div class="metric-count">@pendingCount</div><div class="metric-title">Pending requests</div><div class="metric-subtitle">Awaiting barangay review</div></div></div></div>
        <div class="col-md-6"><div class="request-card metric-card"><div class="metric-icon ready"><i class="bi bi-file-earmark-check"></i></div><div><div class="metric-count">@readyCount</div><div class="metric-title">Ready for pickup</div><div class="metric-subtitle">Your clearance is ready</div></div></div></div>
    </div>

    @if (Model?.HasActiveAlert == true && !string.IsNullOrWhiteSpace(Model.AlertMessage))
    {
        <div class="request-alert p-3 mb-4 d-flex align-items-start gap-3">
            <i class="bi bi-check-circle-fill"></i>
            <div><strong class="d-block">@Model.AlertMessage.Split(". Bring", StringSplitOptions.None)[0].Trim().TrimEnd('.') .</strong><span class="small">Bring a valid ID and your request number to the barangay hall during office hours.</span></div>
        </div>
    }

    <div class="request-card p-3 p-lg-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <h3 class="h5 fw-bold mb-0">All requests</h3>
            <div class="input-group input-group-sm toolbar-search">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input id="requestSearch" type="search" class="form-control" placeholder="Search document or request number" aria-label="Search document or request number" />
            </div>
        </div>
        <div class="filter-pills d-flex gap-2 mb-3" role="group" aria-label="Filter requests by status">
            <button type="button" class="btn btn-sm filter-pill active" data-filter="all">All (@allCount)</button>
            <button type="button" class="btn btn-sm btn-outline-secondary filter-pill" data-filter="pending">Pending (@pendingCount)</button>
            <button type="button" class="btn btn-sm btn-outline-secondary filter-pill" data-filter="ready">Ready for pickup (@readyCount)</button>
            <button type="button" class="btn btn-sm btn-outline-secondary filter-pill" data-filter="rejected">Rejected (@rejectedCount)</button>
        </div>

        @if (!requests.Any())
        {
            <div class="empty-state"><i class="bi bi-file-earmark-text fs-2 d-block mb-2"></i>No requests yet. Use <strong>Request Document</strong> to submit your first document.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table request-table align-middle mb-0" id="requestsTable">
                    <thead><tr><th>DOCUMENT / REQUEST NO.</th><th>PURPOSE</th><th>SUBMITTED</th><th>STATUS</th><th>INBOX / ATTACHMENT</th><th class="text-end">ACTION</th></tr></thead>
                    <tbody>
                    @foreach (var request in requests)
                    {
                        var label = StatusLabel(request.Status);
                        var filter = label.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "pending" : label.Equals("Ready for pickup", StringComparison.OrdinalIgnoreCase) ? "ready" : (IsRejected(request.Status) || IsCancelled(request.Status)) ? "rejected" : "issued";
                        var canEdit = string.Equals(request.Status, "Pending", StringComparison.OrdinalIgnoreCase);
                        var canDownload = string.Equals(request.Status, "Ready for download", StringComparison.OrdinalIgnoreCase)
                            && !string.IsNullOrWhiteSpace(request.DocumentPdfUrl);
                        var isCancelled = IsCancelled(request.Status);
                        <tr data-status="@filter" data-search="@($"{request.DocumentName} {request.RequestNo} {request.Purpose} {label}")">
                            <td><div class="d-flex align-items-center gap-2"><span class="document-icon"><i class="bi bi-file-earmark-text"></i></span><div><div class="request-title">@request.DocumentName</div><div class="request-meta">@request.RequestNo</div></div></div></td>
                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(request.Purpose) ? "—" : request.Purpose)</td>
                            <td class="small text-muted">@request.SubmittedDate</td>
                            <td><span class="request-status @StatusClass(request.Status)">@label</span></td>
                            <td>
                                @if (isCancelled)
                                {
                                    @* Cancelled requests keep the row for the record, but the
                                       inbox is closed: no barangay updates will arrive and no
                                       attachment can be claimed. *@
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                            title="Inbox is unavailable for cancelled requests"
                                            aria-label="Inbox unavailable for cancelled @request.DocumentName request">
                                        <i class="bi bi-inbox me-1"></i>Inbox
                                    </button>
                                }
                                else if (string.IsNullOrWhiteSpace(request.DocumentPdfUrl))
                                {
                                    <button type="button" class="btn btn-sm btn-primary"
                                            data-request-no="@request.RequestNo"
                                            data-document="@request.DocumentName"
                                            data-status="@label"
                                            data-certificate-note="@request.CertificateNote"
                                            onclick="openResidentInboxModal(this)">
                                        <i class="bi bi-inbox-fill me-1"></i>Inbox
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-primary"
                                            data-request-no="@request.RequestNo"
                                            data-document="@request.DocumentName"
                                            data-status="@label"
                                            data-certificate-note="@request.CertificateNote"
                                            data-pdf-url="@request.DocumentPdfUrl"
                                            onclick="openResidentInboxModal(this)">
                                        <i class="bi bi-inbox-fill me-1"></i>Inbox
                                    </button>
                                }
                            </td>
                            <td class="text-end">
                                @if (isCancelled)
                                {
                                    @* A cancelled request is dead paperwork: every workflow
                                       action is withdrawn and the resident's only remaining
                                       choice is to clear the row from their list. *@
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            title="Delete this cancelled request"
                                            aria-label="Delete cancelled @request.DocumentName request"
                                            data-request-no="@request.RequestNo"
                                            data-document="@request.DocumentName"
                                            onclick="deleteResidentRequest(this)">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                }
                                else
                                {
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-sm btn-success"
                                                data-document="@request.DocumentName"
                                                data-request-no="@request.RequestNo"
                                                onclick="openPaymentModal(this)">Payment</button>
                                        <button type="button" class="btn btn-sm btn-outline-light"
                                                title="View barangay feedback"
                                                aria-label="View feedback for @request.DocumentName request"
                                                data-request-no="@request.RequestNo"
                                                data-status="@label"
                                                data-admin-reply="@request.AdminReply"
                                                onclick="openResidentPaymentStatusModal(this)">
                                            <span class="position-relative d-inline-block">
                                                <i class="bi bi-chat-left-text text-primary"></i>
                                                @if (request.HasUnreadReply)
                                                {
                                                    <span class="unread-reply-badge badge bg-danger rounded-circle position-absolute top-0 start-100 translate-middle" aria-label="Unread reply from the Barangay Secretary"></span>
                                                }
                                            </span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-light"
                                                title="@(canEdit ? "Edit request" : "Only pending requests can be edited")"
                                                aria-label="Edit @request.DocumentName request"
                                                data-request-id="@request.RequestNo"
                                                data-purpose-category="@request.PurposeCategory"
                                                data-specific-remarks="@request.SpecificRemarks"
                                                data-claim-format="@request.ClaimFormat"
                                                data-status="@request.Status"
                                                onclick="openEditRequestModal(this)"
                                                disabled="@(!canEdit)">
                                            <i class="bi bi-pencil-square text-info"></i>
                                        </button>
                                        @if (canEdit)
                                        {
                                            @* Withdrawal is only offered while the request is still
                                               Pending; once the barangay starts processing it, the
                                               resident can no longer cancel from this screen. *@
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    title="Cancel this request"
                                                    aria-label="Cancel @request.DocumentName request"
                                                    data-request-no="@request.RequestNo"
                                                    data-document="@request.DocumentName"
                                                    onclick="cancelResidentRequest(this)">
                                                <i class="bi bi-x-circle me-1"></i>Cancel
                                            </button>
                                        }
                                        @if (canDownload)
                                        {
                                            <a class="btn btn-sm btn-primary"
                                               href="@request.DocumentPdfUrl"
                                               download
                                               title="Download the digital copy of @request.DocumentName">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
                                            </a>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between flex-wrap gap-2 border-top mt-3 pt-3 text-muted small"><span id="requestCountText">Showing 1-@allCount of @allCount requests</span><span>Only your personal requests are shown.</span></div>
        }
    </div>

    <div class="row g-3">
        <div class="col-lg-6"><div class="instruction-card"><h3><i class="bi bi-info-circle text-primary me-2"></i>What happens next?</h3><p>Pending requests are awaiting barangay review. Processing time varies by document. Open a request to check its progress and pickup instructions.</p></div></div>
        <div class="col-lg-6"><div class="instruction-card"><h3><i class="bi bi-building text-primary me-2"></i>Collecting a document</h3><p>Wait until your request is marked Ready for pickup. Visit the barangay hall Mon–Fri, 8:00 AM–5:00 PM, with your valid ID and request number.</p></div></div>
    </div>
</div>

<!-- ===== Payment Modal ===== -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">
                    <i class="bi bi-phone me-2"></i>Pay via @paymentMethodName
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Resident" asp-action="SubmitPaymentProof" method="post" enctype="multipart/form-data" id="paymentProofForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" id="paymentProofRequestId" />
                <div class="modal-body">
